        local function readBuildData(name)
            if not (readfile and isfile and HttpService) then return nil, "File read not supported" end
            if not name or name == "" then return nil, "Select a build first" end
            if not isfile(buildPath(name)) then return nil, "Build not found" end
            local ok, fileContent = pcall(readfile, buildPath(name))
            if not ok or type(fileContent) ~= "string" then return nil, "Read failed" end
            local ok2, data = pcall(function() return HttpService:JSONDecode(fileContent) end)
            if not ok2 or type(data) ~= "table" or type(data.entries) ~= "table" then
                return nil, "Invalid build file"
            end
            return data
        end

        local function exportBuildCode(name)
            local data, err = readBuildData(name)
            if not data then return nil, err end
            local payload = {
                v = 1,
                n = name,
                e = data.entries,
            }
            local ok, encoded = pcall(function() return HttpService:JSONEncode(payload) end)
            if not ok or type(encoded) ~= "string" then return nil, "Encode failed" end
            return "RSCB1:" .. encoded
        end

        local function importBuildCode(code)
            if type(code) ~= "string" then return nil, "Paste a code first" end
            code = code:gsub("^%s+", ""):gsub("%s+$", "")
            if code:sub(1, 6) ~= "RSCB1:" then
                return nil, "Invalid code (need RSCB1:...)"
            end
            local raw = code:sub(7)
            local ok, payload = pcall(function() return HttpService:JSONDecode(raw) end)
            if not ok or type(payload) ~= "table" or type(payload.e) ~= "table" then
                return nil, "Invalid / corrupt code"
            end
            local name = tostring(payload.n or "Imported")
                :gsub('[\\/:*?"<>|]', "")
                :gsub("^%s+", ""):gsub("%s+$", "")
            if name == "" then name = "Imported" end
            local base = name
            local i = 1
            while isfile and isfile(buildPath(name)) do
                i += 1
                name = base .. "_" .. i
            end
            if not ensureFolder() then return nil, "Couldn't create folder" end
            local saveData = {
                version = 1,
                name = name,
                entries = payload.e,
                savedAt = os.time(),
            }
            local ok2, json = pcall(function() return HttpService:JSONEncode(saveData) end)
            if not ok2 then return nil, "Encode failed" end
            local ok3 = pcall(writefile, buildPath(name), json)
            if not ok3 then return nil, "Write failed" end
            return name, #payload.e
        end

