						end
						if playerChooserFrame then playerChooserFrame.Visible = true; playerChooserFrame.Position = UDim2.new(0.5,158,1,5); playerChooserFrame.Size = UDim2.fromOffset(568,0); playerChooserFrame.BackgroundTransparency = 1 end
						if playerChooserStroke then playerChooserStroke.Transparency = 1 end
						if keyBadge then
							local label = tostring(command.DisplayName or command.Command or command.Name or "COMMAND")
							local measured = 70 + (#label * 7)
							local chipWidth = math.clamp(measured, 78, 168)
							keyBadge.AnchorPoint = Vector2.new(0,0.5)
							keyBadge.Position = UDim2.new(0,16,0.5,0)
							keyBadge.Size = UDim2.fromOffset(chipWidth,38)
							keyBadgeTitle.Text = "COMMAND"
							keyBadgeTitle.Visible = false
							keyBadgeValue.Text = label
							keyBadgeValue.TextSize = 12
							keyBadgeValue.TextXAlignment = Enum.TextXAlignment.Left
							keyBadgeValue.TextYAlignment = Enum.TextYAlignment.Center
							keyBadgeValue.Position = UDim2.new(0,34,0,0)
							keyBadgeValue.Size = UDim2.new(1,-42,1,0)
							keyBadgeTitle.TextColor3 = Color3.fromRGB(190,190,205)
							keyBadgeValue.TextTransparency = 0
							keyBadgeValue.Visible = true
							if keyBadgeCommandIcon then
								keyBadgeCommandIcon.Visible = true
								local iconName = command.Icon
								local iconData
								if iconName then pcall(function() iconData = lib:GetCustomIcon(iconName) end) end
								if type(iconName) == "string" and (iconName:find("rbxasset") or iconName:find("http")) then
									keyBadgeCommandIcon.Image = iconName
								elseif iconData and (iconData.Url or iconData[1]) then
									keyBadgeCommandIcon.Image = iconData.Url or iconData[1]
									keyBadgeCommandIcon.ImageRectOffset = iconData.ImageRectOffset or Vector2.zero
									keyBadgeCommandIcon.ImageRectSize = iconData.ImageRectSize or Vector2.zero
								else pcall(function() lib:ApplyLucideIcon(keyBadgeCommandIcon, iconData or iconName or "terminal") end) end
							end
						end
						if prefixEditor then prefixEditor.Visible = false end
						if searchIcon then searchIcon.Visible = false end
						if inputContainer then
							local chipWidth = keyBadge and keyBadge.Size.X.Offset or 80
							inputContainer.Position = UDim2.new(0,chipWidth+28,0,0)
							inputContainer.Size = UDim2.new(1,-(chipWidth+48),1,0)
						end
						if commandPlaceholder then commandPlaceholder.Text = command.Handler == "teleport" and "Search location or player..." or "Search player name..."; commandPlaceholder.Visible = true end
						if commandSearch then commandSearch.Text = ""; commandSearch.CursorPosition = 1; pcall(function() commandSearch:CaptureFocus() end) end
						playCommandTween("results-chooser-expand", resultsFrame, 0.28, { Size = UDim2.fromOffset(304,271), Position = UDim2.new(0.5,-290,1,5), BackgroundTransparency = 0.12 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						if resultsStroke then playCommandTween("results-chooser-stroke", resultsStroke, 0.25, { Transparency = 0.28 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out) end
						if playerChooserFrame then playCommandTween("player-chooser-expand", playerChooserFrame, 0.34, { Size = UDim2.fromOffset(568,271), BackgroundTransparency = 0.12 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out) end
						if playerChooserStroke then playCommandTween("player-chooser-stroke", playerChooserStroke, 0.3, { Transparency = 0.22, Thickness = 1.2 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out) end
						playCommandTween("panel-position", panel, 0.32, { Position = UDim2.new(0.5,0,0.14,0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						renderPlayerChooser("")
						if commandSearch then pcall(function() commandSearch:CaptureFocus() end) end
						if source ~= "" then playSavitarCommandSound(0.08,1.45) end
					end

					unlockPlayerChooser = function()
						if not CommandBarState.LockedCommand then return end
						local command = CommandBarState.LockedCommand
						local searchText = command.Command or command.Name or ""
						resetChooserLayout(false)
						if commandSearch then
							commandSearch.Text = searchText
							commandSearch.CursorPosition = #commandSearch.Text + 1
							pcall(function() commandSearch:CaptureFocus() end)
						end
						if commandPlaceholder then commandPlaceholder.Visible = false end
						renderCommandResults(searchText)
						playSavitarCommandSound(0.06,1.25)
					end

					addConnection(lockedCommandCard.Activated, function()
				if CommandBarState.IsOpen and CommandBarState.LockedCommand and unlockPlayerChooser then
					playSavitarCommandSound(0.18, 1.2)
					unlockPlayerChooser()
				end
			end)

			addConnection(UserInputService.InputBegan, function(input, gameProcessed)
			if CommandBarState.Destroyed then return end
			if CommandBarState.IsOpen then
				if input.KeyCode == Enum.KeyCode.Escape then
					closePalette()
					return
				end
				if UserInputService:GetFocusedTextBox() == commandSearch and #CommandBarState.VisibleCandidates > 0 then
					if input.KeyCode == Enum.KeyCode.Down or input.KeyCode == Enum.KeyCode.Up then
						local direction = input.KeyCode == Enum.KeyCode.Down and 1 or -1
						local selected = CommandBarState.SelectedIndex or 1
						selected = ((selected - 1 + direction) % #CommandBarState.VisibleCandidates) + 1
						CommandBarState.SelectedIndex = selected
						if CommandBarState.LockedCommand and updatePlayerChooserSelection then
							updatePlayerChooserSelection(true)
						else
						for rowIndex, candidateRow in ipairs(CommandBarState.Rows) do
							if candidateRow and candidateRow:IsA("TextButton") then
								local stroke = candidateRow:FindFirstChildOfClass("UIStroke")
								local pill = candidateRow:FindFirstChild("AccentPill")
								candidateRow.BackgroundTransparency = rowIndex == selected and 0.12 or 0.38
								if stroke then stroke.Transparency = rowIndex == selected and 0.15 or 0.45 end
								if pill then pill.Visible = rowIndex == selected end
								end
							end
							end
							playSavitarCommandSound(0.05, input.KeyCode == Enum.KeyCode.Down and 1.36 or 1.48)
						return
					end
				end
				if UserInputService:GetFocusedTextBox() then return end
				local picker = options and options.CommandBarKeybind
				local keyName = picker and picker.Value or "L"
				if input.KeyCode and input.KeyCode.Name == keyName then closePalette() end
				return
			end
			if not CommandBarState.Enabled or UserInputService:GetFocusedTextBox() then return end
			local picker = options and options.CommandBarKeybind
			local keyName = picker and picker.Value or "L"
			if input.KeyCode and input.KeyCode.Name == keyName then openPalette() end
		end)

		refreshCandidates()
		renderCommandResults("")

		CommandBarState.Cleanup = function()
			if CommandBarState.Destroyed then return end
			CommandBarState.Destroyed = true
			CommandBarState.IsOpen = false
			for index = #CommandBarState.Connections, 1, -1 do
				local connection = table.remove(CommandBarState.Connections, index)
				pcall(function() connection:Disconnect() end)
			end
			for index = #CommandBarState.RowConnections, 1, -1 do
				local connection = table.remove(CommandBarState.RowConnections, index)
				pcall(function() connection:Disconnect() end)
			end
			for index = #CommandBarState.PlayerRowConnections, 1, -1 do
				local connection = table.remove(CommandBarState.PlayerRowConnections, index)
				pcall(function() connection:Disconnect() end)
			end
			for _, entry in ipairs(CommandBarState.PlayerChooserRows) do
				if entry.Button and entry.Button.Parent then pcall(function() entry.Button:Destroy() end) end
			end
			table.clear(CommandBarState.PlayerChooserRows)
			table.clear(CommandBarState.PlayerCandidates)
			for _, row in ipairs(CommandBarState.Rows) do
				pcall(function() row:Destroy() end)
			end
			table.clear(CommandBarState.Rows)
			table.clear(CommandBarState.VisibleCandidates)
			for key, tween in pairs(activeCommandTweens) do
				pcall(function() tween:Cancel() end)
				activeCommandTweens[key] = nil
			end
			if commandBlur then
				pcall(function()
					if commandBlurCreated then
						commandBlur:Destroy()
					else
						commandBlur.Size = previousBlurSize or 0
						commandBlur.Enabled = previousBlurEnabled == true
					end
				end)
			end
			if commandRoot then pcall(function() commandRoot:Destroy() end) end
			if getgenv()._HuiGCommandBarState == CommandBarState then
				getgenv()._HuiGCommandBarState = nil
			end
		end

		getgenv()._HuiGCommandBarState = CommandBarState
		if type(lib.UnloadSignals) == "table" then
			table.insert(lib.UnloadSignals, CommandBarState.Cleanup)
		end
	end


	fn18("Script loaded in " .. math.round((tick() - getgenv().LoadTime) * 100) / 100 .. " seconds", "HuiG Custom", 71450094482101)
	getgenv().LoadTime = nil

	return {
		copyright = "Copyright (c) 2026 HuiG Custom. All rights reserved.",
	}
end
