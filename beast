	-- HuiG Sync: players running HuiG see each other's car, jet and cape. Clients can't message each other, but an
	-- animation played on your own character replicates to everyone, so an effect that's on plays an invisible
	-- marker animation (weight ~0) whose speed is the effect's code. Every HuiG client watches the other players
	-- for those markers and builds the effect on their character locally. Kept on tbl12 rather than a local: the
	-- main function is at Luau's 200-local limit.
	do
		local HuiGSync = {}
		tbl12.HuiGSync = HuiGSync
		local Players = game:GetService("Players")
		local MARKER_ID = "182393478" -- stock R6 "toolnone" animation: every client can load it
		-- codes 0.016 apart, matched within 0.004. "drift" has no builder: the car copies read it with Has()
		local CODES = { car = 0.031, cape = 0.047, jet = 0.063, drift = 0.079, car2 = 0.095, car3 = 0.111, car4 = 0.127 }
		local builders = {} -- name -> function(player) -> stop function
		local wanted, mine = {}, {} -- our own effects that are on, and their marker { track, animator }
		local shown = {} -- other player -> name -> stop function (or true while building)
		local seen = {} -- other player -> name -> true, from the last scan

		local function animatorOf(character)
			local hum = character and character:FindFirstChildOfClass("Humanoid")
			return hum and hum:FindFirstChildOfClass("Animator")
		end

		-- one track per effect, reused while the character lives (the drift marker flips on and off a lot)
		local function playMarker(name)
			local animator = animatorOf(Players.LocalPlayer.Character)
			if not animator then
				return
			end
			local m = mine[name]
			if not (m and m.animator == animator) then
				local anim = Instance.new("Animation")
				anim.AnimationId = "rbxassetid://" .. MARKER_ID
				local ok, track = pcall(animator.LoadAnimation, animator, anim)
				if not ok then
					return
				end
				track.Priority = Enum.AnimationPriority.Core
				track.Looped = true
				m = { track = track, animator = animator }
				mine[name] = m
			end
			pcall(function()
				m.track:Play(0, 0.001, CODES[name])
			end)
		end

		function HuiGSync.Register(name, build)
			builders[name] = build
		end

		-- cheap enough to call every frame: it only starts or stops the marker when that changes
		function HuiGSync.SetLocal(name, on)
			local m = mine[name]
			if on then
				wanted[name] = true
				if not (m and m.track.IsPlaying) then
					playMarker(name)
				end
			else
				wanted[name] = nil
				if m and m.track.IsPlaying then
					pcall(function()
						m.track:Stop(0)
					end)
				end
			end
		end

		-- whether another player's marker for `name` was playing at the last scan
		function HuiGSync.Has(player, name)
			local list = seen[player]
			return list ~= nil and list[name] == true
		end

		local function drop(list, name)
			local stop = list[name]
			list[name] = nil
			if type(stop) == "function" then
				pcall(stop)
			end
		end

		task.spawn(function()
			while not flag11 do
				-- our markers die with the character: put them back after a respawn
				for name in pairs(wanted) do
					local m = mine[name]
					if not (m and m.track.IsPlaying) then
						playMarker(name)
					end
				end
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= Players.LocalPlayer then
						local found = {}
						local animator = animatorOf(player.Character)
						if animator then
							for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
								local id = track.Animation and track.Animation.AnimationId or ""
								if id:sub(-#MARKER_ID) == MARKER_ID then
									for name, code in pairs(CODES) do
										if math.abs(track.Speed - code) < 0.004 then
											found[name] = true
										end
									end
								end
							end
						end
						seen[player] = found
						local list = shown[player] or {}
						shown[player] = list
						for name, build in pairs(builders) do
							if found[name] and not list[name] then
								list[name] = true
								task.spawn(function()
									local ok, stop = pcall(build, player)
									stop = ok and type(stop) == "function" and stop or nil
									if list[name] == true and shown[player] == list then
										list[name] = stop or function() end
									elseif stop then
										pcall(stop) -- turned off while it was loading
									end
								end)
							elseif not found[name] and list[name] then
								drop(list, name)
							end
						end
					end
				end
				for player, list in pairs(shown) do
					if player.Parent ~= Players then
						for name in pairs(list) do
							drop(list, name)
						end
						shown[player] = nil
						seen[player] = nil
					end
				end
				task.wait(0.25)
			end
			-- unloaded
			for _, list in pairs(shown) do
				for name in pairs(list) do
					drop(list, name)
				end
			end
			table.clear(shown)
			table.clear(seen)
			for name in pairs(mine) do
				HuiGSync.SetLocal(name, false)
			end
		end)
	end

