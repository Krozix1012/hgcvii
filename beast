		local function describeValue(candidate)
			local object = candidate.Object
			if candidate.Kind == "Command" then
				return object and object.Usage or "COMMAND"
			elseif candidate.Kind == "Player" then
				return "PLAYER"
			elseif candidate.Kind == "Location" then
				return "LOCATION"
			elseif candidate.Kind == "Tab" then
