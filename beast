					openPlayerChooser = function(command, sourceText)
						if not command or not command.RequiresArgument then return end
						local source = trim(sourceText or command.Command)
						CommandBarState.LockedCommand = command
						CommandBarState.CommandFilter = command.Command
						CommandBarState.SelectedIndex = 1
						for index = #CommandBarState.RowConnections, 1, -1 do local connection = table.remove(CommandBarState.RowConnections,index); pcall(function() connection:Disconnect() end) end
						for _, row in ipairs(CommandBarState.Rows) do if row and row.Parent then pcall(function() row:Destroy() end) end end
						table.clear(CommandBarState.Rows)
