			local targetPlayer, playerError
			if typeof(query) == "Instance" and query:IsA("Player") then targetPlayer = query
			else targetPlayer, playerError = findPlayerByQuery(query) end
			local character, root
			if tbl12 and tbl12.Char then character, root = tbl12.Char() end
			if targetPlayer and targetPlayer ~= localPlayer then
				local targetCharacter, targetRoot = tbl12.Char(targetPlayer)
				if not (root and targetRoot and targetRoot.Parent) then return false, "Your character or the target character is not ready." end
				local ok, result = pcall(function()
