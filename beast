		renderCommandResults = function(rawQuery)
			if not (results and results.Parent) then return end
			if CommandBarState.LockedCommand then
				if renderPlayerChooser then renderPlayerChooser(rawQuery or "") end
				return
			end
			for index = #CommandBarState.RowConnections, 1, -1 do
				local connection = table.remove(CommandBarState.RowConnections, index)
				pcall(function() connection:Disconnect() end)
			end
			for index = #CommandBarState.PlayerRowConnections, 1, -1 do
				local connection = table.remove(CommandBarState.PlayerRowConnections, index)
				pcall(function() connection:Disconnect() end)
			end
			for _, entry in ipairs(CommandBarState.PlayerChooserRows) do
				if entry.Button and entry.Button.Parent then pcall(function() entry.Button:Destroy() end) end
			end
			if playerChooserScroll then
				for _, child in ipairs(playerChooserScroll:GetChildren()) do
					if child.Name == "EmptyPlayers" or child.Name:match("^ChooserSection_") then pcall(function() child:Destroy() end) end
				end
				playerChooserScroll.CanvasPosition = Vector2.zero
			end
			table.clear(CommandBarState.PlayerChooserRows)
			table.clear(CommandBarState.PlayerCandidates)
			for _, row in ipairs(CommandBarState.Rows) do
				if row and row.Parent then row:Destroy() end
			end
			table.clear(CommandBarState.Rows)
			table.clear(CommandBarState.VisibleCandidates)

			local query = trim(queryFromInput(rawQuery)):lower()
			local found = {}
			local contextCommand, contextRest = matchBuiltinCommand(rawQuery)
			if contextCommand and contextCommand.RequiresArgument then
				found = contextualCandidates(contextCommand, contextRest)
			else
				for _, candidate in ipairs(CommandBarState.Candidates) do
					local score = scoreCandidate(candidate, query)
					if score ~= nil then
						table.insert(found, { Candidate = candidate, Score = score })
					end
				end
			end
			table.sort(found, function(a, b)
				if a.Score ~= b.Score then return a.Score < b.Score end
				if a.Candidate.Kind ~= b.Candidate.Kind and query == "" then
					return a.Candidate.Kind == "Tab"
				end
				return a.Candidate.Name:lower() < b.Candidate.Name:lower()
			end)

			local maximum = math.min(#found, 8)
			CommandBarState.SelectedIndex = 1
			local popupHeight = maximum == 0 and 60 or (61 + (math.min(5, maximum) - 1) * 51 + 6)
			local hasQuery = trim(tostring(rawQuery or "")) ~= ""
			local shouldShowResults = CommandBarState.IsOpen and hasQuery
			local wasShowingResults = resultsFrame.Visible
			if shouldShowResults then
				resultsFrame.Visible = true
				if not wasShowingResults then
					resultsFrame.Size = UDim2.fromOffset(680, 0)
					resultsFrame.BackgroundTransparency = 1
					if resultsStroke then resultsStroke.Transparency = 1 end
					playCommandTween("results-open", resultsFrame, 0.28, { Size = UDim2.fromOffset(680, popupHeight), BackgroundTransparency = 0.24 }, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
