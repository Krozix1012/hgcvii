        local function encodeCFrame(cf)
            local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
            return {x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22}
        end

        local function decodeCFrame(t)
            if type(t) ~= "table" or #t < 12 then return nil end
            local ok, cf = pcall(function()
                return CFrame.new(t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11], t[12])
            end)
            return ok and cf or nil
        end

        local function collectAnchored()
            local entries = {}
            local seen = {}

            local function addEntry(model, cf)
                if not model or seen[model] then return end
                if typeof(cf) ~= "CFrame" then
                    local ok, piv = pcall(function()
                        if model:IsA("Model") then return model:GetPivot() end
                        if model:IsA("BasePart") then return model.CFrame end
                    end)
                    if not ok or not piv then return end
                    cf = piv
                end
                seen[model] = true
                table.insert(entries, {
                    name = model.Name,
                    cframe = encodeCFrame(cf),
                })
            end

            if tbl7.Anchored then
                for target, state in pairs(tbl7.Anchored) do
                    if state and state.Anchored then
                        local model = state.Model
                        if not model and typeof(target) == "Instance" then
                            if target:IsA("Model") then
                                model = target
                            elseif target:IsA("Player") then
                                model = target.Character
                            else
                                model = target:FindFirstAncestorOfClass("Model") or target
                            end
                        end
                        if model and (model:IsA("Model") or model:IsA("BasePart")) then
                            addEntry(model, state.CFrame)
                        end
                    end
                end
            end

            local function scan(container, depth)
                if not container or depth > 6 then return end
                for _, child in ipairs(container:GetChildren()) do
                    if seen[child] then continue end
                    if child:IsA("Model") or child:IsA("BasePart") then
                        local marker = child:FindFirstChild("AnchorHighlight", true)
                        if marker then
                            addEntry(child, nil)
                        end
                    end
                    if child:IsA("Folder") or child:IsA("Model") then
                        scan(child, depth + 1)
                    end
                end
            end

            for _, folder in ipairs(getSpawnFolders()) do
                scan(folder, 0)
            end

            for _, plr in pairs(Players:GetPlayers()) do
                local f = workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
                if f then scan(f, 0) end
            end
            local plotItems = workspace:FindFirstChild("PlotItems")
            if plotItems then scan(plotItems, 0) end

            return entries
        end

        local function saveBuild(name)
            if not (writefile and HttpService) then return false, "File save not supported" end
            if type(name) ~= "string" or name == "" then return false, "Enter a name" end
            if not ensureFolder() then return false, "Couldn't create folder" end

            local entries = collectAnchored()
            if #entries == 0 then
                return false, "No anchored objects found (nothing has AnchorHighlight)"
            end

            local payload = {
                version = 1,
                name = name,
                timestamp = os.date("%Y-%m-%d %H:%M:%S"),
                count = #entries,
                entries = entries,
            }

            local ok, encoded = pcall(function() return HttpService:JSONEncode(payload) end)
            if not ok or type(encoded) ~= "string" then return false, "Encode failed" end

            local okWrite = pcall(writefile, buildPath(name), encoded)
            if not okWrite then return false, "Write failed" end

            return true, #entries
        end

