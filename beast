		local function performCandidate(candidate, fromSuggestion)
			if not candidate then return false end
			if candidate.Kind == "Player" or candidate.Kind == "Location" then
				local command = CommandBarState.LockedCommand or matchBuiltinCommand(commandSearch and commandSearch.Text or "")
				if not command then return false, "Type a command first, for example: tp player" end
				dispatchBuiltinCommand(command, candidate.Object, fromSuggestion and "rbxassetid://86827880171546" or nil)
				return true, nil
			elseif candidate.Kind == "Command" then
				local command = candidate.Object
				if command.RequiresArgument then
					if openPlayerChooser then
						openPlayerChooser(command, commandSearch and commandSearch.Text or command.Command)
						return false
					end
					if commandSearch and commandSearch.Parent then
						commandSearch.Text = command.Command .. " "
						commandSearch:CaptureFocus()
						task.defer(function()
							if commandSearch and commandSearch.Parent then commandSearch.CursorPosition = #commandSearch.Text + 1 end
						end)
					end
					setStatus("Usage: " .. command.Usage)
					return false
				end
				dispatchBuiltinCommand(command, nil, fromSuggestion and "rbxassetid://86827880171546" or nil)
				return true, nil
			elseif candidate.Kind == "Tab" then
				local ok = pcall(function() candidate.Object:Show() end)
				if ok then
					closePalette(fromSuggestion and "rbxassetid://86827880171546" or nil)
					return true, "Opened tab " .. candidate.Name
				end
				return false, "Could not open tab " .. candidate.Name
			elseif candidate.Kind == "Toggle" then
				local targetValue = not candidate.Object.Value
				local ok = pcall(function() candidate.Object:SetValue(targetValue) end)
				if ok then
					return true, (targetValue and "Enabled " or "Disabled ") .. candidate.Name
				end
				return false, "Could not change " .. candidate.Name
