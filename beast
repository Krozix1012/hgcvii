		local function scoreCandidate(candidate, query)
			if query == "" then
				if candidate.Kind == "Command" then return 0 end
				if candidate.Kind == "Tab" then return 1 end
				return 4
			end
			local name, id, kind = candidate.Name:lower(), candidate.Id:lower(), candidate.Kind:lower()
			if name == query then return 0 end
			if id == query then return 0 end
			if name:sub(1, #query) == query then return 1 end
			if id:sub(1, #query) == query then return 1 end
			if name:find(query, 1, true) then return 2 end
			if id:find(query, 1, true) then return 3 end
			if kind:find(query, 1, true) then return 4 end
			return nil
		end

		local function findCandidate(query, kinds)
			query = trim(query):lower()
			if query == "" then return nil end
			local best, bestScore
			for _, candidate in ipairs(CommandBarState.Candidates) do
				local kindAllowed = not kinds or kinds[candidate.Kind] == true
				if kindAllowed then
					local name, id = candidate.Name:lower(), candidate.Id:lower()
					local score
					if name == query or id == query then
						score = 0
					elseif name:sub(1, #query) == query or id:sub(1, #query) == query then
						score = 1
					elseif name:find(query, 1, true) or id:find(query, 1, true) then
						score = 2
					end
					if score and (not bestScore or score < bestScore) then
						best, bestScore = candidate, score
					end
				end
			end
			return best
		end

		local function matchBuiltinCommand(rawText)
			local input = trim(rawText)
			local activePrefix = tostring(CommandBarState.Prefix or ".")
			if activePrefix ~= "" and input:sub(1, #activePrefix) == activePrefix then input = trim(input:sub(#activePrefix + 1)) end
			local lowerInput = input:lower()
			local bestCommand, bestAlias, bestLength
			for _, command in ipairs(BuiltinCommands) do
				for _, alias in ipairs(command.Aliases or { command.Command }) do
					local lowerAlias = alias:lower()
					local matches = lowerInput == lowerAlias or lowerInput:sub(1, #lowerAlias + 1) == lowerAlias .. " "
					if matches and (not bestLength or #lowerAlias > bestLength) then
						bestCommand, bestAlias, bestLength = command, alias, #lowerAlias
					end
				end
			end
			if bestCommand then return bestCommand, trim(input:sub(bestLength + 1)) end
			if lowerInput == "" or lowerInput:find("%s") then return nil end
			local partialCommand
			for _, command in ipairs(BuiltinCommands) do
				for _, alias in ipairs(command.Aliases or { command.Command }) do
					local lowerAlias = alias:lower()
					if lowerAlias:sub(1, #lowerInput) == lowerInput then
						if partialCommand and partialCommand ~= command then return nil end
						partialCommand = command
					end
				end
			end
			if partialCommand then return partialCommand, "" end
			return nil
		end

