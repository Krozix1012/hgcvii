			local function spawnOne()
				local root = myRoot()
				if not root then
					notify("No character")
					return nil
				end

				local spawnCf = (root.CFrame + Vector3.new(0, 12, 0)) * spawnRotation
				local pencil = nil

				local okSpawn, result = pcall(function()
					return tbl12.SpawnToy("ToolPencil", spawnCf, 5, true)
				end)
				if okSpawn then
					pencil = result
				end

				if not pencil then
					local folderName = localPlayer.Name .. "SpawnedInToys"
					local folder = workspace:FindFirstChild(folderName)
					local seen = {}
					if folder then
						for _, ch in ipairs(folder:GetChildren()) do
							if ch.Name == "ToolPencil" then
								seen[ch] = true
							end
						end
					end
					pcall(function()
						if tbl11 and tbl11.SpawnToy then
							tbl11.SpawnToy:InvokeServer("ToolPencil", spawnCf, Vector3.new(0, 90, 0))
						end
					end)
					local t0 = os.clock()
					while os.clock() - t0 < 4 do
						folder = workspace:FindFirstChild(folderName)
						if folder then
							for _, ch in ipairs(folder:GetChildren()) do
								if ch.Name == "ToolPencil" and not seen[ch] then
									pencil = ch
									break
								end
							end
						end
						if pencil then
							break
						end
						task.wait(0.05)
					end
				end

				if not pencil then
					notify("Spawn failed (ToolPencil)")
					return nil
				end

				local sticky = pencil:WaitForChild("StickyPart", 3)
				if sticky then
					pcall(function()
						sticky:WaitForChild("StickyWeld", 2)
					end)
				end
				local sound = pencil:FindFirstChild("SoundPart")
				if not sticky then
					pcall(function()
						if tbl12.DestroyToy then
							tbl12.DestroyToy(pencil)
						end
					end)
					notify("No StickyPart")
					return nil
				end

				pcall(function()
					if tbl12.BreakHoldable then
						tbl12.BreakHoldable(pencil)
					end
				end)
				return pencil, sticky, sound
			end

			local function stickTo(pencil, sticky, sound, target, cf)
				if not (pencil and sticky and target) then
					return false
				end
				tbl12.OwnershipBurst({ sound or sticky }, true)
				fireSticky(sticky, target, cf)
				local startedAt = os.clock()
				while os.clock() - startedAt < 1.5 do
					if not (pencil.Parent and sticky.Parent and target.Parent) then
						return false
					end
					if isStuck(sticky, target) then
						pcall(function()
							for _, ch in ipairs(sticky:GetChildren()) do
								if ch:IsA("TouchTransmitter") or ch.Name == "TouchInterest" then
									ch:Destroy()
								end
							end
						end)
						return true
					end
					task.wait(0.05)
				end
				return isStuck(sticky, target)
			end

