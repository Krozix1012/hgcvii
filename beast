					tbl12.UpdateLadderSpider = function()
						local ls = tbl7.LadderSpider
						if not tbl8.LadderSpider then
							return
						end

						local char, hrp, hum = tbl12.Char()
						if not (hrp and hum and hum.Health > 0) then
							return
						end

						local now = os.clock()
						local dt = math.min(now - (ls.Clock or now), 0.08)
						ls.Clock = now

						local moveDir = hum.MoveDirection
						local walking = moveDir.Magnitude > 0.08
						local height = ls.Height or 9
						local radius = ls.Radius or 12
						local speed = ls.Speed or 52
						local animSpeed = ls.AnimSpeed or 7
						local liftAmt = ls.Lift or 3.5
						local hipClear = ls.HipClearance or 3.2
						local hipY = ls.HipY or -0.15
						local gap = ls.Gap or 2.0
						local upperOut = ls.UpperOut or 1.5
						local upperDown = ls.UpperDown or 0.2
						local lowerOut = ls.LowerOut or 0.0
						local footHeight = ls.FootHeight or 0.45
						local strideScale = ls.StrideScale or 0.16
						local angFront = math.rad(ls.AngFront or 58)
						local angBack = math.rad(ls.AngBack or 122)
						local flipLower = ls.FlipLower == true
						local lenScale = ls.LenScale or 1.0
						local orientPitch = math.rad(ls.OrientPitch or 90)
						local bodyBob = ls.BodyBob or 0.2

						local rayParams = RaycastParams.new()
						rayParams.FilterType = Enum.RaycastFilterType.Exclude
						local filter = { char }
						for _, m in ipairs(ls.Models) do
							filter[#filter + 1] = m
						end
						rayParams.FilterDescendantsInstances = filter
						local hit = workspace:Raycast(hrp.Position + Vector3.new(0, 3, 0), Vector3.new(0, -100, 0), rayParams)
						local groundY = hit and hit.Position.Y or (hrp.Position.Y - height)

						local look = hrp.CFrame.LookVector
						local flatLook = Vector3.new(look.X, 0, look.Z)
						if flatLook.Magnitude < 1e-3 then
							flatLook = Vector3.new(0, 0, -1)
						else
							flatLook = flatLook.Unit
						end
						local flatRight = Vector3.new(-flatLook.Z, 0, flatLook.X)

						local pos = hrp.Position
						if walking then
							ls.Phase = ls.Phase + dt * animSpeed * (0.7 + moveDir.Magnitude * 0.5)
							pos = pos + moveDir.Unit * speed * dt
						end
						local targetY = groundY + height
						pos = Vector3.new(pos.X, pos.Y + (targetY - pos.Y) * math.min(dt * 10, 1), pos.Z)
						tbl12.Teleport(hrp, CFrame.new(pos) * (hrp.CFrame - hrp.Position))

						local bodyPos = pos
						local bob = walking and math.sin(ls.Phase * 2) * bodyBob or 0
						bodyPos = bodyPos + Vector3.new(0, bob, 0)

						local legDefs = {
							{ ang = -angFront, pair = 0 },
							{ ang =  angFront, pair = 1 },
							{ ang = -angBack,  pair = 1 },
							{ ang =  angBack,  pair = 0 },
						}

						local function placeLadder(data, center, dir)
							if not data or not data.Root then
								return
							end
							local root = data.Root
							if dir.Magnitude < 1e-4 then
								dir = Vector3.new(0, -1, 0)
							else
								dir = dir.Unit
							end
							local cf = CFrame.lookAt(center, center + dir) * CFrame.Angles(orientPitch, 0, 0)
							if root.CFrame ~= cf then
								root.CFrame = cf
							end
							tbl12.ResetVelocity(root)
						end

						for leg = 1, 4 do
							local upperModel = ls.Models[leg * 2 - 1]
							local lowerModel = ls.Models[leg * 2]
							local upperData = upperModel and ls.Parts[upperModel]
							local lowerData = lowerModel and ls.Parts[lowerModel]
							if not (upperData and lowerData) then
								continue
							end

							local upperLen = (upperData.Length or 4) * lenScale
							local lowerLen = (lowerData.Length or 4) * lenScale

							local def = legDefs[leg]
							local ang = def.ang
							local pair = def.pair

							local outward = flatLook * math.cos(ang) + flatRight * math.sin(ang)
							if outward.Magnitude > 1e-4 then
								outward = outward.Unit
							else
								outward = flatRight
							end

							local phase = ls.Phase + pair * math.pi
							local swing = math.sin(phase)

							local lift = 0
							local stride = 0
							if walking then
								lift = math.max(0, swing) * liftAmt
								stride = -swing * (radius * strideScale)
							end

							local hip = bodyPos + outward * hipClear + Vector3.new(0, hipY, 0)

							local upperDir = (outward * upperOut + Vector3.new(0, -upperDown, 0) + flatLook * (stride * 0.12))
							if upperDir.Magnitude > 1e-4 then
								upperDir = upperDir.Unit
							else
								upperDir = outward
							end
							local upperCenter = hip + upperDir * (upperLen * 0.5)
							placeLadder(upperData, upperCenter, upperDir)

							local upperEnd = hip + upperDir * upperLen

							local footY = groundY + footHeight + lift
							local footXZ = bodyPos + outward * radius + flatLook * stride
							local foot = Vector3.new(footXZ.X, footY, footXZ.Z)

							local toFoot = foot - upperEnd
							local lowerStart
							if toFoot.Magnitude > 0.1 then
								lowerStart = upperEnd + toFoot.Unit * gap
							else
								lowerStart = upperEnd + Vector3.new(0, -gap, 0)
							end

							local lowerDir = foot - lowerStart
							if lowerDir.Magnitude < 0.2 then
								lowerDir = outward * lowerOut + Vector3.new(0, -1, 0)
							end
							lowerDir = lowerDir.Unit
							if flipLower then
								lowerDir = -lowerDir
							end

							local lowerCenter
							if flipLower then
								lowerCenter = foot + lowerDir * (lowerLen * 0.5)
							else
								lowerCenter = foot - lowerDir * (lowerLen * 0.5)
							end

							local bottomY = lowerCenter.Y - math.abs(lowerDir.Y) * (lowerLen * 0.5)
							if bottomY < groundY + 0.3 then
								lowerCenter = lowerCenter + Vector3.new(0, (groundY + 0.3) - bottomY, 0)
							end
							placeLadder(lowerData, lowerCenter, lowerDir)
						end

						if #ls.Models < 8 then
							tbl12.SpawnLadderSpider()
						end
					end

