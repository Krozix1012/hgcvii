							playerChooserFrame.Position = UDim2.new(0.5, 158, 1, 5)
							playerChooserFrame.BackgroundTransparency = 0.12
						end
						if playerChooserStroke then playerChooserStroke.Transparency = 0.28 end
						if #CommandBarState.PlayerCandidates == 0 then
							local empty = Instance.new("TextLabel")
							empty.Name = "EmptyPlayers"
							empty.Size = UDim2.new(1,0,0,44)
							empty.Position = UDim2.new(0,0,0,8)
							empty.BackgroundTransparency = 1
