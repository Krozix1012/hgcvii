			end
		end

		local function resolveDropdownValue(object, rawValue)
			local values = object.Values
			local sequential = type(values) == "table" and #values > 0
			if object.Multi then
				local selected = {}
				for token in tostring(rawValue):gmatch("[^,|]+") do
					token = trim(token)
					local matchValue
					if type(values) == "table" then
						if sequential then
							for _, value in ipairs(values) do
								if tostring(value):lower() == token:lower() then matchValue = value; break end
							end
						else
							for key in pairs(values) do
								if tostring(key):lower() == token:lower() then matchValue = key; break end
							end
						end
					end
					if matchValue ~= nil then selected[matchValue] = true end
				end
				return next(selected) and selected or rawValue
			end
			if type(values) == "table" then
				if sequential then
					for _, value in ipairs(values) do
						if tostring(value):lower() == tostring(rawValue):lower() then return value end
					end
				else
					for key in pairs(values) do
						if tostring(key):lower() == tostring(rawValue):lower() then return key end
					end
				end
			end
			return rawValue
		end

		local function runCommand(raw)
			local text = trim(raw)
			if text == "" then return end

			if CommandBarState.LockedCommand then
				local picked
				if text == "" then
					picked = CommandBarState.VisibleCandidates[CommandBarState.SelectedIndex or 1]
				else
					local normalized = normalizeLookup(text)
					for _, candidate in ipairs(CommandBarState.VisibleCandidates) do
						if normalizeLookup(candidate.Id) == normalized or normalizeLookup(candidate.Name) == normalized then picked = candidate; break end
						local object = candidate.Object
						if typeof(object) == "Instance" and object:IsA("Player") and (normalizeLookup(object.Name) == normalized or normalizeLookup(object.DisplayName) == normalized) then picked = candidate; break end
					end
					if not picked then
						local resolved = findPlayerByQuery(text)
						if resolved then picked = { Kind = "Player", Id = resolved.Name, Name = resolved.DisplayName, Object = resolved } end
					end
				end
				if not picked then
					rejectCommandAttempt(text ~= "" and ("No matching player or destination: " .. text) or "No player or destination selected.")
					return
				end
				dispatchBuiltinCommand(CommandBarState.LockedCommand, picked.Object, "rbxassetid://86827880171546")
				return
			end

			local prefix = tostring(CommandBarState.Prefix or ".")
			if prefix ~= "" and text:sub(1, #prefix) == prefix then text = trim(text:sub(#prefix + 1)) end
			if text == "" then return end

			local builtin, argument = matchBuiltinCommand(text)
			if not builtin then
				rejectCommandAttempt("Unknown command. Use one of the listed HuiG Custom commands.")
				return
			end

			if builtin.RequiresArgument then
				if trim(argument) == "" then
					local picked = CommandBarState.VisibleCandidates[CommandBarState.SelectedIndex or 1]
					if picked and (picked.Kind == "Player" or picked.Kind == "Location") then
