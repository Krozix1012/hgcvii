					renderPlayerChooser = function(rawQuery)
						if not (CommandBarState.LockedCommand and playerChooserFrame and playerChooserScroll) then return end
						CommandBarState.clearPlayerChooserRows()
						local command = CommandBarState.LockedCommand
						local query = trim(rawQuery):lower()
						local found = {}
						local function add(candidate, group, score)
							table.insert(found, { Candidate = candidate, Group = group, Score = score or 4 })
						end
						local handler = command.Handler
						if handler == "target" and (query == "" or ("server"):sub(1, #query) == query or query == "all" or query == "everyone") then
							local serverCandidate = { Kind = "Player", Id = "server", Name = "Apply Method - Server", Object = "server", IsServer = true }
							local score = query == "" and 0 or scoreCandidate(serverCandidate, query)
							if query == "" or score then add(serverCandidate, 0, score or 0) end
						end
						if handler == "teleport" then
							for _, location in ipairs(getTeleportLocations()) do
								local candidate = { Kind = "Location", Id = location.Name, Name = location.Name, Object = location }
								local score = scoreCandidate(candidate, query)
								if score ~= nil then add(candidate, 1, score) end
							end
						end
						local PlayersService = game:GetService("Players")
						local localPlayer = PlayersService.LocalPlayer
						local includeSelf = handler == "copyuser" or handler == "copyuserid"
						for _, playerObject in ipairs(PlayersService:GetPlayers()) do
							if includeSelf or playerObject ~= localPlayer then
								local candidate = { Kind = "Player", Id = playerObject.Name, Name = playerObject.DisplayName .. "  @" .. playerObject.Name, Object = playerObject }
								local score = scoreCandidate(candidate, query)
								if score ~= nil then add(candidate, handler == "teleport" and 2 or 1, score) end
							end
						end
						table.sort(found, function(a, b)
								if a.Group ~= b.Group then return a.Group < b.Group end
								if a.Score ~= b.Score then return a.Score < b.Score end
								return a.Candidate.Name:lower() < b.Candidate.Name:lower()
						end)
						local layoutOrder = 0
						local lastGroup = nil
						table.clear(CommandBarState.VisibleCandidates)
						for _, item in ipairs(found) do
							if item.Group ~= lastGroup then
								if item.Group == 1 or item.Group == 2 then
									layoutOrder += 1
									local heading = handler == "teleport" and item.Group == 1 and "LOCATIONS" or "PLAYERS"
									CommandBarState.makeChooserSection(heading, layoutOrder)
								end
								lastGroup = item.Group
							end
							table.insert(CommandBarState.PlayerCandidates, item.Candidate)
							local index = #CommandBarState.PlayerCandidates
							CommandBarState.VisibleCandidates[index] = item.Candidate
							layoutOrder += 1
							local entry = CommandBarState.MakeChooserRow(item.Candidate, index)
							entry.Button.LayoutOrder = layoutOrder
							table.insert(CommandBarState.PlayerChooserRows, entry)
						end
						CommandBarState.SelectedIndex = math.clamp(CommandBarState.SelectedIndex or 1, 1, math.max(1,#CommandBarState.PlayerCandidates))
