                    local t = math.clamp(((position.X - ForestRiverA.X) * dx + (position.Z - ForestRiverA.Z) * dz) / denominator, 0, 1)
                    return math.sqrt((position.X - ForestRiverA.X + dx * t) ^ 2 + (position.Z - ForestRiverA.Z + dz * t) ^ 2)
                end

