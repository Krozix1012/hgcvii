        local function liquidGlassConnect(signal, callback)
            local ok, connection = pcall(function()
                return signal:Connect(callback)
            end)
            if ok and connection then
                table.insert(LiquidGlassState.Connections, connection)
                return connection
            end
            return nil
        end

        local function liquidGlassOwn(instance)
            if instance and not LiquidGlassState.CreatedSet[instance] then
                LiquidGlassState.CreatedSet[instance] = true
                table.insert(LiquidGlassState.Created, instance)
            end
            return instance
        end

        local function liquidGlassRemember(instance, property)
            if not instance then return end
            local snapshot = LiquidGlassState.Originals[instance]
            if not snapshot then
                snapshot = { Values = {}, Saved = {} }
                LiquidGlassState.Originals[instance] = snapshot
            end
            if snapshot.Saved[property] then return end
            local ok, value = pcall(function()
                return instance[property]
            end)
            if ok then
                snapshot.Values[property] = value
                snapshot.Saved[property] = true
            end
        end

        local function liquidGlassSet(instance, property, value)
            if not instance then return end
            liquidGlassRemember(instance, property)
            pcall(function()
                instance[property] = value
            end)
        end

        local function liquidGlassTween(instance, info, goals)
            if not instance then return nil end
            for property in pairs(goals) do
                liquidGlassRemember(instance, property)
            end
            local previous = LiquidGlassState.Tweens[instance]
            if previous then
                pcall(function() previous:Cancel() end)
            end
            local ok, tween = pcall(function()
                return TweenService:Create(instance, info, goals)
            end)
            if not ok or not tween then return nil end
            LiquidGlassState.Tweens[instance] = tween
            pcall(function() tween:Play() end)
            return tween
        end

        local function liquidGlassCreate(className, name, parent)
            local instance = liquidGlassOwn(Instance.new(className))
            if name then instance.Name = name end
            if parent then instance.Parent = parent end
            return instance
        end

        local function liquidGlassProtected(instance)
            local forceStyle = LiquidGlassConfig.ForceStyle
            local function isToyCellName(name)
                if not name or name == "" then
                    return false
                end
                if forceStyle and forceStyle[name] then
                    return true
                end
                if SPAWNABLE_TOYS and SPAWNABLE_TOYS[name] then
                    return true
                end
                return false
            end

            if instance then
                local node = instance
                local forceDepth = 0
                while node and forceDepth < 8 do
                    if isToyCellName(node.Name) then
                        return false
                    end
                    node = node.Parent
                    forceDepth += 1
                end
            end

            local function containsKeyword(name)
                local lowerName = string.lower(name or "")
                for _, keyword in ipairs(LiquidGlassConfig.Keywords) do
                    if string.find(lowerName, keyword, 1, true) then
                        return true
                    end
                end
                return false
            end

            if containsKeyword(instance.Name) then return true end
            local parent = instance.Parent
            local depth = 0
            while parent and depth < 4 do
                if (parent:IsA("GuiObject") or parent:IsA("Folder")) and containsKeyword(parent.Name) then
                    return true
                end
                parent = parent.Parent
                depth += 1
            end
            return instance:IsA("TextBox")
        end

        local function liquidGlassMelt(parent, mousePosition)
            if not LiquidGlassState.Active or not parent or not parent:IsA("GuiObject") then return end
            local frame = Instance.new("Frame")
            LiquidGlassState.MeltEffects[frame] = true
            frame.Name = "HuiGLiquidGlassMelt"
            frame.BackgroundColor3 = Color3.new(1, 1, 1)
            frame.BackgroundTransparency = LiquidGlassConfig.GhostVFXAlpha
            frame.AnchorPoint = Vector2.new(0.5, 0.5)
            local absolutePosition = parent.AbsolutePosition
            local insetY = LiquidGlassGuiService:GetGuiInset().Y
            frame.Position = UDim2.fromOffset(
                mousePosition.X - absolutePosition.X,
                mousePosition.Y - insetY - absolutePosition.Y
            )
            frame.Size = UDim2.fromOffset(0, 0)
            frame.ZIndex = 5000
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = frame
            frame.Parent = parent
            liquidGlassTween(frame, TweenInfo.new(LiquidGlassConfig.MeltDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(800, 800),
                BackgroundTransparency = 1,
            })
            Debris:AddItem(frame, LiquidGlassConfig.MeltDuration + 0.1)
            task.delay(LiquidGlassConfig.MeltDuration + 0.15, function()
                LiquidGlassState.MeltEffects[frame] = nil
                LiquidGlassState.Tweens[frame] = nil
            end)
        end

        local function liquidGlassStyle(instance)
            if not LiquidGlassState.Active or not instance or not instance:IsA("GuiObject") then return end
            if LiquidGlassState.Styled[instance] then return end
            LiquidGlassState.Styled[instance] = true

            local lowerName = string.lower(instance.Name)
            if lowerName == "close" or lowerName == "closebutton" or lowerName == "exit" or lowerName == "x" then
                liquidGlassSet(instance, "AnchorPoint", Vector2.new(1, 0))
                liquidGlassSet(instance, "Position", UDim2.new(1, 0, 0, 0))
                return
            end

            local isFavorite = string.find(lowerName, "star", 1, true)
                or string.find(lowerName, "favorite", 1, true)
                or string.find(lowerName, "fav", 1, true)
            if isFavorite then
                liquidGlassSet(instance, "BackgroundTransparency", 1)
                liquidGlassSet(instance, "BorderSizePixel", 0)
                liquidGlassRemember(instance, "Rotation")
                local baseRotation = instance.Rotation
                local scale = instance:FindFirstChildOfClass("UIScale")
                if not scale then
                    scale = liquidGlassCreate("UIScale", "HuiGLiquidGlassScale", instance)
                    scale.Scale = 1
                else
                    liquidGlassRemember(scale, "Scale")
                end
                local baseScale = scale.Scale
                liquidGlassConnect(instance.MouseEnter, function()
                    if LiquidGlassState.Active and instance.Parent then
                        liquidGlassTween(instance, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 15 })
                    end
                end)
                liquidGlassConnect(instance.MouseLeave, function()
                    if LiquidGlassState.Active and instance.Parent then
                        liquidGlassTween(instance, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = baseRotation })
                    end
                end)
                if instance:IsA("GuiButton") then
                    liquidGlassConnect(instance.MouseButton1Down, function()
                        if LiquidGlassState.Active and instance.Parent then
                            liquidGlassTween(scale, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Scale = baseScale * 0.8 })
                        end
                    end)
                    liquidGlassConnect(instance.MouseButton1Up, function()
                        if LiquidGlassState.Active and instance.Parent then
                            liquidGlassTween(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale * 1.2 })
                            task.delay(0.16, function()
                                if LiquidGlassState.Active and scale.Parent then
                                    liquidGlassTween(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale })
                                end
                            end)
                        end
                    end)
                end
                return
            end

            local isPanelSurface = instance:IsA("Frame") or instance:IsA("ScrollingFrame")
            if isPanelSurface
                and not LiquidGlassState.CreatedSet[instance]
                and not LiquidGlassState.MeltEffects[instance] then
                local function enforceTransparentPanel()
                    if not LiquidGlassState.Active or not instance.Parent then return end
                    if instance.BackgroundTransparency < 1 then
                        liquidGlassSet(instance, "BackgroundTransparency", 1)
                    end
                    if instance.BorderSizePixel ~= 0 then
                        liquidGlassSet(instance, "BorderSizePixel", 0)
                    end
                end

                liquidGlassSet(instance, "BackgroundTransparency", 1)
                liquidGlassSet(instance, "BorderSizePixel", 0)
                liquidGlassConnect(instance:GetPropertyChangedSignal("BackgroundTransparency"), enforceTransparentPanel)
                liquidGlassConnect(instance:GetPropertyChangedSignal("BorderSizePixel"), enforceTransparentPanel)
            end

            if liquidGlassProtected(instance) then return end

            if instance:IsA("Frame") or instance:IsA("ScrollingFrame") then
                liquidGlassSet(instance, "BackgroundTransparency", 1)
                liquidGlassSet(instance, "BorderSizePixel", 0)
            elseif instance:IsA("TextLabel") or instance:IsA("TextButton") then
                liquidGlassSet(instance, "BackgroundTransparency", 1)
            end
            liquidGlassSet(instance, "BackgroundTransparency", 1)
            liquidGlassSet(instance, "BackgroundColor3", Color3.new(1, 1, 1))

            if not instance:FindFirstChildOfClass("UICorner") then
                local corner = liquidGlassCreate("UICorner", "HuiGLiquidGlassCorner", instance)
                corner.CornerRadius = UDim.new(0, 16)
            end

            if instance:IsA("TextButton") or instance:IsA("ImageButton") then
                local glow = instance:FindFirstChild("LiquidGlow")
                if not (glow and glow:IsA("UIStroke")) then
                    glow = liquidGlassCreate("UIStroke", "LiquidGlow", instance)
                else
                    liquidGlassRemember(glow, "Thickness")
                    liquidGlassRemember(glow, "Color")
                    liquidGlassRemember(glow, "Transparency")
                    liquidGlassRemember(glow, "ApplyStrokeMode")
                    liquidGlassRemember(glow, "Enabled")
                end
                liquidGlassSet(glow, "Thickness", 0)
                liquidGlassSet(glow, "Color", Color3.new(1, 1, 1))
                liquidGlassSet(glow, "Transparency", 0.5)
                liquidGlassSet(glow, "ApplyStrokeMode", Enum.ApplyStrokeMode.Border)
                liquidGlassSet(glow, "Enabled", true)

                local scale = instance:FindFirstChildOfClass("UIScale")
                if not scale then
                    scale = liquidGlassCreate("UIScale", "HuiGLiquidGlassScale", instance)
                    scale.Scale = 1
                else
                    liquidGlassRemember(scale, "Scale")
                end
                local baseScale = scale.Scale
                local isTextButton = instance:IsA("TextButton")
                local baseTextSize, baseTextColor
                if isTextButton then
                    liquidGlassRemember(instance, "TextSize")
                    liquidGlassRemember(instance, "TextColor3")
                    baseTextSize = instance.TextSize
                    baseTextColor = instance.TextColor3
                end

                local function setHover(hovered)
                    if not LiquidGlassState.Active or not instance.Parent then return end
                    local goals
                    if hovered then
                        goals = {
                            BackgroundTransparency = LiquidGlassConfig.HoverGlowAlpha,
                            BackgroundColor3 = Color3.fromRGB(230, 240, 255),
                        }
                        if isTextButton then
                            goals.TextSize = baseTextSize + 2
                            goals.TextColor3 = Color3.fromRGB(150, 200, 255)
                        end
                        liquidGlassTween(instance, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), goals)
                        liquidGlassTween(glow, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Thickness = 2.4 })
                        liquidGlassTween(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale * 1.05 })
                    else
                        goals = {
                            BackgroundTransparency = 1,
                            BackgroundColor3 = LiquidGlassConfig.GlassColor,
                        }
                        if isTextButton then
                            goals.TextSize = baseTextSize
                            goals.TextColor3 = baseTextColor
                        end
                        liquidGlassTween(instance, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), goals)
                        liquidGlassTween(glow, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Thickness = 0 })
                        liquidGlassTween(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale })
                    end
                end

                liquidGlassConnect(instance.MouseEnter, function() setHover(true) end)
                liquidGlassConnect(instance.MouseLeave, function() setHover(false) end)
                liquidGlassConnect(instance.MouseButton1Down, function()
                    if not LiquidGlassState.Active or not instance.Parent then return end
                    if instance.Name ~= "HuiGLiquidGlassRejoinButton" then
                        liquidGlassTween(scale, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Scale = baseScale * 0.93 })
                    end
                    liquidGlassMelt(instance, LiquidGlassUserInput:GetMouseLocation())
                end)
                liquidGlassConnect(instance.MouseButton1Up, function()
                    if LiquidGlassState.Active and instance.Parent and instance.Name ~= "HuiGLiquidGlassRejoinButton" then
                        liquidGlassTween(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale * 1.05 })
                    end
                end)
            end
        end

