		local function runTargetMethod(methodName, query)
			local lowered = (typeof(query) == "Instance" and query:IsA("Player")) and "" or normalizeLookup(query)
			local isServer = lowered == "server" or lowered == "all" or lowered == "everyone" or lowered == "allplayers"
			local methods = { [methodName] = true }
			local previousMethods = tbl7.TargetMethods
			if isServer then return false, "This command requires one player name." end

			local target, err = findPlayerByQuery(query)
			if not target then return false, err end
			local localPlayer = game:GetService("Players").LocalPlayer
			if target == localPlayer then return false, "That target action cannot be run on yourself." end
			if tbl12.IsProtectedPlayer and tbl12.IsProtectedPlayer(target) then return false, "Reso's player protection blocked that target." end
			if not waitForLiveTargetCharacter(target) then return false, "Target left before respawning." end

			if methodName == "Kill" then
				if type(tbl12.Kill) ~= "function" then return false, "Reso's one-shot Kill method is unavailable." end
				local ok, failure = pcall(tbl12.Kill, target)
				if not ok then return false, "Reso Kill failed: " .. tostring(failure) end
				return true, "Kill applied once to " .. target.DisplayName .. "."
			elseif methodName == "Bring" then
				if type(tbl12.BringPlayer) ~= "function" then return false, "Reso's one-shot Bring method is unavailable." end
				local ok, result = pcall(tbl12.BringPlayer, target)
				if not ok then return false, "Reso Bring failed: " .. tostring(result) end
				if result == false or result == nil then return false, "Bring could not be applied to " .. target.DisplayName .. ". Check that the target is available and Reso has the required network ownership." end
				return true, "Bring applied once to " .. target.DisplayName .. "."
			end

			local ok, failure = pcall(function()
				tbl7.TargetMethods = methods
				tbl12.ProcessPlayer(target, false, false, false)
			end)
			tbl7.TargetMethods = previousMethods
			if not ok then return false, "Reso target action failed: " .. tostring(failure) end
			return true, methodName .. " action sent for " .. target.DisplayName .. "."
		end

		local function executeBuiltinCommand(command, argument)
			if not command then return false, "Unknown command." end
			local handler = command.Handler
			local argumentText = trim(typeof(argument) == "string" and argument or "")
			if command.RequiresArgument and argument == nil and typeof(argument) ~= "Instance" then
				return false, "Usage: " .. (command.Usage or command.Command .. " <argument>")
			end
			if handler == "teleport" then return teleportToQuery(argument) end
			if handler == "view" then return spectatePlayer(argument) end
			if handler == "copyuser" then return copyPlayerField(argument, "Name") end
			if handler == "copyuserid" then return copyPlayerField(argument, "UserId") end
			if handler == "target" then return runTargetMethod(command.TargetMethod, argument) end
			if handler == "unview" then
				local spectateToggle = toggles and toggles.LoopSpectatePlayer
				if not spectateToggle or type(spectateToggle.SetValue) ~= "function" then
					return false, "Reso's spectate control is unavailable."
				end
				local ok, failure = pcall(function() spectateToggle:SetValue(false) end)
				if not ok then return false, "Could not stop spectating: " .. tostring(failure) end
				return true, "Stopped spectating."
			end
			if handler == "togglecontrol" then
				local control = toggles and toggles[command.ControlId]
				if not control or type(control.SetValue) ~= "function" then
					return false, (command.ControlLabel or command.ControlId or "Toggle") .. " is unavailable."
				end
				local requested = argumentText:lower()
				local desired
				if requested == "" then
					desired = not (control.Value == true)
				elseif requested == "on" or requested == "enable" or requested == "enabled" or requested == "true" then
					desired = true
				elseif requested == "off" or requested == "disable" or requested == "disabled" or requested == "false" then
					desired = false
				else
					return false, "Use: " .. (command.Usage or command.Command .. " [on/off]")
				end
				if command.ControlId == "BreakBarrierT" and desired then
					local alreadyBroken = false
					pcall(function() alreadyBroken = tbl12.IsBarrierBroken() end)
					if alreadyBroken then
						if control.Value == true then pcall(function() control:SetValue(false) end) end
						return true, "House barrier is already broken; DHB is disabled."
					end
				end
				local ok, failure = pcall(function() control:SetValue(desired) end)
				if not ok then return false, "Could not change " .. (command.ControlLabel or command.ControlId) .. ": " .. tostring(failure) end
				return true, (desired and "Enabled " or "Disabled ") .. (command.ControlLabel or command.ControlId) .. "."
			end
			if handler == "rejoin" then
				local ok, failure = pcall(function() tbl12.Rejoin(tbl8.RejoinWithAntiLag ~= false, tbl8.RejoinWithScript) end)
				if ok then return true, "Reso rejoin requested." end
				return false, "Rejoin failed: " .. tostring(failure)
			end
			if handler == "lobotomy" then
				local action = tbl7 and tbl7.CommandBarActions and tbl7.CommandBarActions.Lobotomy
				if type(action) ~= "function" then return false, "Lobotomy action is unavailable." end
				task.spawn(function()
