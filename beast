		local function applyRedShader(level)
		    local t = level / 10
		    local target = ScarletPreset.Lighting
		    local orig = originalLighting

		    Lighting.Brightness = lerpNum(orig.Brightness or 2, target.Brightness, t)
		    Lighting.ColorShift_Bottom = lerpColor(orig.ColorShift_Bottom or Color3.new(0,0,0), target.ColorShift_Bottom, t)
		    Lighting.ColorShift_Top = lerpColor(orig.ColorShift_Top or Color3.new(1,1,1), target.ColorShift_Top, t)
		    Lighting.OutdoorAmbient = lerpColor(orig.OutdoorAmbient or Color3.fromRGB(128,128,128), target.OutdoorAmbient, t)
		    Lighting.ClockTime = lerpNum(orig.ClockTime or 12, target.ClockTime, t)
		    Lighting.FogColor = lerpColor(orig.FogColor or Color3.fromRGB(192,192,192), target.FogColor, t)
		    Lighting.FogEnd = lerpNum(orig.FogEnd or 100000, target.FogEnd, t)
		    Lighting.FogStart = lerpNum(orig.FogStart or 0, target.FogStart, t)
		    Lighting.ExposureCompensation = lerpNum(orig.ExposureCompensation or 0, target.ExposureCompensation, t)
		    Lighting.ShadowSoftness = lerpNum(orig.ShadowSoftness or 0.5, target.ShadowSoftness, t)
		    Lighting.Ambient = lerpColor(orig.Ambient or Color3.new(0,0,0), target.Ambient, t)

		    for _, inst in pairs(shaderInstances) do
		        if inst:IsA("BloomEffect") then
		            inst.Intensity = lerpNum(0, ScarletPreset.Bloom.Intensity, t)
		            inst.Size = lerpNum(0, ScarletPreset.Bloom.Size, t)
		            inst.Threshold = ScarletPreset.Bloom.Threshold
		        elseif inst:IsA("BlurEffect") then
		            inst.Size = lerpNum(0, ScarletPreset.Blur.Size, t)
		        elseif inst:IsA("ColorCorrectionEffect") then
		            inst.Saturation = lerpNum(0, ScarletPreset.ColorCorrection.Saturation, t)
		            inst.TintColor = lerpColor(Color3.new(1,1,1), ScarletPreset.ColorCorrection.TintColor, t)
		        elseif inst:IsA("SunRaysEffect") then
		            inst.Intensity = lerpNum(0, ScarletPreset.SunRays.Intensity, t)
		        end
		    end
		end

		local function applyGenericShader(preset, level)
		    local t = level / 10
		    local target = preset.Lighting
		    local orig = originalLighting

		    Lighting.Brightness = lerpNum(orig.Brightness or 2, target.Brightness, t)
		    Lighting.ColorShift_Bottom = lerpColor(orig.ColorShift_Bottom or Color3.new(0,0,0), target.ColorShift_Bottom, t)
		    Lighting.ColorShift_Top = lerpColor(orig.ColorShift_Top or Color3.new(1,1,1), target.ColorShift_Top, t)
		    Lighting.OutdoorAmbient = lerpColor(orig.OutdoorAmbient or Color3.fromRGB(128,128,128), target.OutdoorAmbient, t)
		    Lighting.ClockTime = lerpNum(orig.ClockTime or 14.5, target.ClockTime, t)
		    Lighting.FogColor = lerpColor(orig.FogColor or Color3.fromRGB(190,205,230), target.FogColor, t)
		    Lighting.FogEnd = lerpNum(orig.FogEnd or 100000, target.FogEnd, t)
		    Lighting.FogStart = lerpNum(orig.FogStart or 0, target.FogStart, t)
		    Lighting.ExposureCompensation = lerpNum(orig.ExposureCompensation or 0, target.ExposureCompensation, t)
		    Lighting.ShadowSoftness = lerpNum(orig.ShadowSoftness or 0.35, target.ShadowSoftness, t)
		    Lighting.Ambient = lerpColor(orig.Ambient or Color3.new(0,0,0), target.Ambient, t)

		    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		    if atm and preset.Atmosphere then
		        local oa = originalAtmosphere or {}
		        local pa = preset.Atmosphere
		        atm.Density = lerpNum(oa.Density or 0.22, pa.Density, t)
		        atm.Offset = lerpNum(oa.Offset or 0.15, pa.Offset, t)
		        atm.Haze = lerpNum(oa.Haze or 0.8, pa.Haze, t)
		        atm.Glare = lerpNum(oa.Glare or 0.15, pa.Glare, t)
		        atm.Color = lerpColor(oa.Color or Color3.fromRGB(200,210,255), pa.Color, t)
		        atm.Decay = lerpColor(oa.Decay or Color3.fromRGB(100,110,130), pa.Decay, t)
		    end

		    for _, inst in pairs(shaderInstances) do
		        if inst:IsA("BloomEffect") and preset.Bloom then
		            inst.Intensity = lerpNum(0, preset.Bloom.Intensity, t)
		            inst.Size = lerpNum(0, preset.Bloom.Size, t)
		            inst.Threshold = preset.Bloom.Threshold
		        elseif inst:IsA("BlurEffect") and preset.Blur then
		            inst.Size = lerpNum(0, preset.Blur.Size, t)
		        elseif inst:IsA("ColorCorrectionEffect") and preset.CC then
		            inst.Brightness = lerpNum(0, preset.CC.Brightness, t)
		            inst.Saturation = lerpNum(0, preset.CC.Saturation, t)
		            inst.Contrast = lerpNum(0, preset.CC.Contrast, t)
		            inst.TintColor = lerpColor(Color3.new(1,1,1), preset.CC.TintColor, t)
		        elseif inst:IsA("SunRaysEffect") and preset.SunRays then
		            inst.Intensity = lerpNum(0, preset.SunRays.Intensity, t)
		            if preset.SunRays.Spread then
		                inst.Spread = preset.SunRays.Spread
		            end
		        end
		    end
		end

		local function applyShader(name, level)
		    destroyShaderInstances()
		    restoreAll()
		    if name == "Scarlet Atmosphere" then
		        buildRedShaderInstances()
		        applyRedShader(level)
		    else
		        local preset = ShaderPresets[name]
		        if preset then
		            buildGenericShaderInstances()
		            applyGenericShader(preset, level)
		        end
		    end
		end

		local function removeShader()
		    destroyShaderInstances()
		    restoreAll()
		end

