				local ok, data = pcall(function()
					return game:GetService("HttpService"):JSONDecode(raw)
				end)
				if ok and type(data) == "table" then
					return data
				end
				ok, data = pcall(function()
					local fn = loadstring(raw)
					return fn and fn()
				end)
				if ok and type(data) == "table" then
					return data
				end
				return nil
			end

