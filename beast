					if not ok then warn("[Reso Command Bar] Lobotomy failed: " .. tostring(failure)) end
				end)
				return true, "Started Lobotomy."
			end
			if handler == "tsunami" then
				local action = tbl7 and tbl7.CommandBarActions and tbl7.CommandBarActions.Tsunami
				if type(action) ~= "function" then return false, "Tsunami action is unavailable." end
				task.spawn(function()
					local ok, failure = pcall(action)
					if not ok then warn("[Reso Command Bar] Tsunami failed: " .. tostring(failure)) end
				end)
				return true, "Make Tsunami started."
			end
			if handler == "jet" then
				local jet = _JET
				if not jet or type(jet._clickCb) ~= "function" then return false, "Jet spawn is unavailable." end
				local ok, failure = pcall(jet._clickCb)
				if ok then return true, "Jet spawn triggered." end
				return false, "Jet spawn failed: " .. tostring(failure)
			end
			return false, "Command handler is not implemented: " .. tostring(handler)
		end

		local function contextualCandidates(command, rest)
			local query = trim(rest):lower()
			local result = {}
			local handler = command and command.Handler
			local needsPlayer = handler == "view" or handler == "copyuser" or handler == "copyuserid" or handler == "target" or handler == "teleport"
			if needsPlayer then
				for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
					local candidate = { Kind = "Player", Id = player.Name, Name = player.DisplayName .. (player.DisplayName ~= player.Name and "  @" .. player.Name or ""), Object = player }
					local score = scoreCandidate(candidate, query)
					if score ~= nil then table.insert(result, { Candidate = candidate, Score = score }) end
				end
			end
			if handler == "teleport" then
				for _, location in ipairs(getTeleportLocations()) do
					local displayName = location.Name
					local id = displayName == "SpookyHouse" and "HauntedHouse" or displayName
					local candidate = { Kind = "Location", Id = id, Name = displayName, Object = location }
					local score = scoreCandidate(candidate, query)
					if score ~= nil then table.insert(result, { Candidate = candidate, Score = score }) end
				end
			end
			table.sort(result, function(a, b)
				if a.Score ~= b.Score then return a.Score < b.Score end
				return a.Candidate.Name:lower() < b.Candidate.Name:lower()
			end)
			return result
		end

