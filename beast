            Blur = nil,
            RejoinPending = false,
        }

        local LiquidGlassConfig = {
            GlassTransparency = 0.90,
            HoverGlowAlpha = 0.85,
            MaxBlurSize = 25,
            BorderTransparency = 0.35,
            CornerRadius = UDim.new(0, 32),
            MeltDuration = 1.4,
