			local LADDER = "LadderLightBrown"
			local SEG_LEN = 22 -- a ladder is 22 x 2 x 4 studs; its long axis is the bounding box X
			local LEG_ANGLES = { math.rad(45), math.rad(135), math.rad(225), math.rad(315) } -- FR, BR, BL, FL
			local STEP_TIME, STEP_LIFT = 0.28, 7
			local SLIDE_IN_TIME = 0.7 -- a newly spawned ladder glides from where it spawned into the leg
			local TURN_RATE = 7 -- how fast the body rotates onto a new surface
			local SIT_ANIMS = { R15 = "rbxassetid://2506281703", R6 = "rbxassetid://178130996" }

			local spider = {
				Enabled = false,
				Generation = 0,
				Active = { 1, 2, 3, 4 },
				Models = {}, -- ladder models in spawn order: leg k, segment s -> (k - 1) * n + s
				Parts = {}, -- model -> { Root = SoundPart, Rel = root -> bounding box, Last, Target, Intro }
				Legs = {}, -- per leg: Foot, Step = { From, T } or nil
				Acquiring = {},
				Body = nil, -- controller: { Pos, Up, Fwd, Fall, Humanoid }
				Pose = nil, -- { Humanoid, Track }: the riding pose
				Spawning = false,
				Dt = 1 / 60,
			}

			local function segCount()
				return options.SpiderLadders and tonumber(options.SpiderLadders.Value) or 2
			end

			local function bodyHeight()
				-- hover height of the body centre over the surface (the old HipHeight value + the R6 legs)
				return (options.SpiderHeight and options.SpiderHeight.Value or 14) + 3
			end

			local function on(id, default)
				local t = toggles[id]
				if t == nil then
					return default
				end
				return t.Value
			end

			local function stopPose()
				if spider.Pose then
					pcall(function()
						spider.Pose.Track:Stop(0.2)
					end)
					spider.Pose = nil
				end
			end

			local function ensurePose(hum)
				if not on("SpiderRidePose", false) then
					stopPose()
					return
				end
				if spider.Pose and spider.Pose.Humanoid == hum and spider.Pose.Track.IsPlaying then
					return
				end
				stopPose()
				local animator = hum:FindFirstChildOfClass("Animator")
				if not animator then
					return
				end
				local animate = hum.Parent and hum.Parent:FindFirstChild("Animate")
				local sitFolder = animate and animate:FindFirstChild("sit")
				local source = sitFolder and sitFolder:FindFirstChildOfClass("Animation")
				local anim = Instance.new("Animation")
				anim.AnimationId = source and source.AnimationId or SIT_ANIMS[hum.RigType.Name]
				pcall(function()
					local track = animator:LoadAnimation(anim)
					track.Priority = Enum.AnimationPriority.Action
					track.Looped = true
					track:Play(0.3)
					spider.Pose = { Humanoid = hum, Track = track }
				end)
			end

			-- hand the body back to the Humanoid, standing upright where it is
			local function releaseBody()
				local body = spider.Body
				spider.Body = nil
				local _, root, hum = tbl12.Char()
				if body and hum and body.Humanoid == hum then
					hum.PlatformStand = false
					if root then
						local f = Vector3.new(body.Fwd.X, 0, body.Fwd.Z)
						f = f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
						root.CFrame = CFrame.lookAt(root.Position, root.Position + f)
						root.AssemblyLinearVelocity = Vector3.zero
					end
				end
			end

			local function clearSpider()
				spider.Generation += 1
				tbl12.SetRuntimeConnection("SpiderLegs", RunService.Heartbeat, false)
				pcall(RunService.UnbindFromRenderStep, RunService, "HuiGSpiderLegs")
				for _, m in ipairs(spider.Models) do
					if m.Parent then
						tbl12.DestroyToy(m)
					end
				end
				table.clear(spider.Models)
				table.clear(spider.Parts)
				table.clear(spider.Legs)
				table.clear(spider.Acquiring)
				releaseBody()
				stopPose()
			end

			local function rayParams()
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				local list = { localPlayer.Character }
				if v17 then
					table.insert(list, v17) -- every toy we own, including the legs themselves
				end
				params.FilterDescendantsInstances = list
				return params
			end

			-- Only solid, fixed geometry counts (anchored + collidable, or terrain): skips invisible helper parts,
			-- other players' toys and the like.
			local function solidRay(origin, dir, params)
				for _ = 1, 6 do
					local hit = workspace:Raycast(origin, dir, params)
					if not hit then
						return nil
					end
					local p = hit.Instance
					if p:IsA("Terrain") or (p.Anchored and p.CanCollide) then
						return hit
					end
					params:AddToFilter(p)
				end
				return nil
			end

			-- big enough to walk on as a wall (not a pole, fence post or hoop)
			local function isBig(inst)
				if inst:IsA("Terrain") then
					return true
				end
				local sz = inst.Size
				local dims = { sz.X, sz.Y, sz.Z }
				table.sort(dims)
				return dims[2] >= 8
			end

			-- can the body stand on a surface with this normal? walls only with Walk Up Walls
			local function walkable(hit, walls)
				return hit.Normal.Y > 0.55 or (walls and isBig(hit.Instance))
			end

			-- rotation that turns `from` onto `to` (both unit)
			local function rotateBetween(from, to)
				local axis = from:Cross(to)
				local dot = math.clamp(from:Dot(to), -1, 1)
				if axis.Magnitude < 1e-4 then
					return dot > 0 and CFrame.identity or CFrame.fromAxisAngle(Vector3.xAxis, math.pi)
				end
				return CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
			end

			-- move input in world space, flat (camera relative)
			local controls = nil
			local function moveInput(hum)
				if not controls then
					pcall(function()
						controls = require(localPlayer.PlayerScripts:FindFirstChild("PlayerModule")):GetControls()
					end)
				end
				local ok, mv = pcall(function()
					return controls:GetMoveVector()
				end)
				local camera = workspace.CurrentCamera
				if ok and typeof(mv) == "Vector3" and camera and mv.Magnitude > 0.05 then
					local look = camera.CFrame.LookVector
					local fwd = Vector3.new(look.X, 0, look.Z)
					fwd = fwd.Magnitude > 1e-3 and fwd.Unit or Vector3.new(0, 0, -1)
					local right = fwd:Cross(Vector3.yAxis)
					local dir = right * mv.X - fwd * mv.Z
					return dir.Magnitude > 1 and dir.Unit or dir
				end
				local md = hum.MoveDirection
				return Vector3.new(md.X, 0, md.Z)
			end

			-- The surface-walking controller. Returns the body frame (up = surface normal) and the body velocity.
			local function updateBody(root, hum, params, height, dt)
				local body = spider.Body
				if not body or body.Humanoid ~= hum then
					local look = root.CFrame.LookVector
					local f = Vector3.new(look.X, 0, look.Z)
					body = {
						Pos = root.Position,
						Up = Vector3.yAxis,
						Fwd = f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1),
						Fall = 0,
						Humanoid = hum,
					}
					spider.Body = body
				end
				hum.PlatformStand = true
				local walls = on("SpiderWalls", false)
				local up = body.Up
				local oldPos = body.Pos

				-- input turned onto the surface: on a wall W (toward the wall) becomes "up the wall", S down
				local input = moveInput(hum)
				local move = Vector3.zero
				if input.Magnitude > 0.05 then
					local m = rotateBetween(Vector3.yAxis, up):VectorToWorldSpace(input)
					m = m - up * m:Dot(up)
					if m.Magnitude > 1e-3 then
						move = m.Unit * math.min(input.Magnitude, 1)
					end
				end
				local step = move * hum.WalkSpeed * dt
				local targetUp = walls and up or Vector3.yAxis
				-- a corner turn is dropped if you head away from that surface again, or if it drags on
				if body.Turn and (move:Dot(body.Turn) > 0.3 or os.clock() - body.TurnAt > 1) then
					body.Turn = nil
				end

				-- inside corner: a surface ahead at the body's lower half
				if step.Magnitude > 1e-4 then
					local ahead = solidRay(body.Pos - up * (height * 0.5), move.Unit * (height * 0.7 + step.Magnitude), params)
					if ahead then
						if walls and walkable(ahead, true) and ahead.Normal:Dot(up) < 0.85 then
							if not body.Turn then
								body.Turn, body.TurnAt = ahead.Normal, os.clock() -- turn onto it
							end
						else
							local into = step:Dot(ahead.Normal)
							if into < 0 then
								step -= ahead.Normal * into -- can't climb it: slide along
							end
						end
					end
				end
				local pos = body.Pos + step

				-- surface under the body
				local down = solidRay(pos + up * 3, -up * (height * 2 + 3), params)
				if down and not walkable(down, walls) then
					down = nil
				end
				if not down and walls and move.Magnitude > 0.05 then
					-- outside corner (top of a wall, edge of a cliff): look back under the edge for the surface
					-- that wraps around it
					local wrap = solidRay(pos - up * (height + 2), -move.Unit * (height * 2), params)
					if wrap and walkable(wrap, true) then
						down = wrap
						if not body.Turn then
							body.Turn, body.TurnAt = wrap.Normal, os.clock()
						end
					end
				end

				if down then
					body.Fall = 0
					if body.Turn then
						-- a corner turn finishes before the surface under the body gets a say again: mid-turn that
						-- ray flips between the ground and the wall and used to leave the body stuck half-turned
						targetUp = body.Turn
						if up:Dot(body.Turn) > 0.97 then
							body.Turn = nil
						end
					elseif walls and move.Magnitude > 0.05 then
						-- follow the surface while moving; standing still the orientation stays put, so a bumpy or
						-- overhanging wall can't slowly walk the body down it
						targetUp = down.Normal
					end
					-- hover at the body height; ease onto it so steps and bumps don't snap
					local want = down.Position + up * height
					pos = pos:Lerp(want, math.min(1, 14 * dt))
				else
					-- nothing to stand on: fall
					body.Fall += workspace.Gravity * dt
					pos += Vector3.new(0, -body.Fall * dt, 0)
					targetUp = Vector3.yAxis
					body.Turn = nil
				end

				-- rotate onto the surface smoothly, keep heading along it
				up = up:Lerp(targetUp, math.min(1, TURN_RATE * dt)).Unit
				local fwd = body.Fwd
				if move.Magnitude > 0.1 then
					fwd = fwd:Lerp(move.Unit, math.min(1, 10 * dt))
				end
				fwd = fwd - up * fwd:Dot(up)
				if fwd.Magnitude < 1e-3 then
					fwd = rotateBetween(body.Up, up):VectorToWorldSpace(body.Fwd)
					fwd = fwd - up * fwd:Dot(up)
				end
				fwd = fwd.Magnitude > 1e-3 and fwd.Unit or up:Cross(Vector3.xAxis).Unit

				body.Pos, body.Up, body.Fwd = pos, up, fwd
				local frame = CFrame.fromMatrix(pos, fwd:Cross(up), up, -fwd)
				root.CFrame = frame
				local vel = (pos - oldPos) / dt
				root.AssemblyLinearVelocity = vel
				root.AssemblyAngularVelocity = Vector3.zero
				return frame, vel
			end

			-- Where a foot plants: a wall between the hip and the spot catches it (Walk Up Walls), else the surface
			-- under the spot (searched from just above it), else under an edge from the hip.
			local function findFoot(hip, spot, up, height, params, walls)
				if walls then
					local block = solidRay(hip, spot - hip, params)
					if block and math.abs(block.Normal:Dot(up)) < 0.5 and isBig(block.Instance) then
						return block.Position
					end
				end
				local hit = solidRay(spot + up * 6, -up * (height * 2 + 20), params)
				if hit then
					return hit.Position
				end
				local expected = spot - up * height
				local edge = solidRay(hip, (expected - hip) * 1.4, params)
				return edge and edge.Position or expected
			end

			-- FABRIK: n segments of SEG_LEN from hip to foot, bent away from the surface (the bend comes from the
			-- starting guess)
			local function solveLeg(hip, foot, n, outward, up)
				local reach = SEG_LEN * n * 0.98
				local toFoot = foot - hip
				if toFoot.Magnitude > reach then
					foot = hip + toFoot.Unit * reach
				end
				local joints = { hip }
				for i = 1, n - 1 do
					local t = i / n
					local arch = math.sin(t * math.pi) * SEG_LEN * 0.9
					joints[i + 1] = hip:Lerp(foot, t) + up * arch + outward * (SEG_LEN * 0.15)
				end
				joints[n + 1] = foot
				for _ = 1, 10 do
					joints[n + 1] = foot
					for i = n, 1, -1 do
						joints[i] = joints[i + 1] + (joints[i] - joints[i + 1]).Unit * SEG_LEN
					end
					joints[1] = hip
					for i = 2, n + 1 do
						joints[i] = joints[i - 1] + (joints[i] - joints[i - 1]).Unit * SEG_LEN
					end
				end
				return joints
			end

			-- Ladder placed so its long axis runs a -> b, rungs facing sideways. It also gets the velocity it is really
			-- moving at, so other clients can extrapolate it with the body instead of trailing behind.
			local function placeLadder(entry, a, b, side, dt)
				local dir = b - a
				if dir.Magnitude < 1e-3 then
					return
				end
				dir = dir.Unit
				-- side must be exactly perpendicular to the ladder: the foot is often out of the hip's plane, and a
				-- skewed matrix gets silently re-orthogonalised by Roblox, turning the ladder off and splitting knees
				side = side - dir * side:Dot(dir)
				if side.Magnitude < 1e-3 then
					side = dir:Cross(Vector3.yAxis)
					if side.Magnitude < 1e-3 then
						side = Vector3.xAxis
					end
				end
				side = side.Unit
				local box = CFrame.fromMatrix((a + b) / 2, dir, side:Cross(dir), side)
				local intro = entry.Intro
				if intro then
					intro.T = math.min(1, intro.T + dt / SLIDE_IN_TIME)
					box = intro.From:Lerp(box, intro.T * intro.T * (3 - 2 * intro.T))
					if intro.T >= 1 then
						entry.Intro = nil
					end
				end
				local linear, angular = Vector3.zero, Vector3.zero
				local last = entry.Last
				if last then
					linear = (box.Position - last.Position) / dt
					local axis, angle = (box.Rotation * last.Rotation:Inverse()):ToAxisAngle()
					angular = axis * angle / dt
					if linear.Magnitude > 250 or angular.Magnitude > 40 then
						-- a jump (respawn, teleport): don't fling the extrapolation
						linear, angular = Vector3.zero, Vector3.zero
					end
				end
				entry.Last = box
				entry.Target = box * entry.Rel:Inverse()
				entry.Root.CFrame = entry.Target
				entry.Root.AssemblyLinearVelocity = linear
				entry.Root.AssemblyAngularVelocity = angular
			end

			-- physics carries each ladder along its velocity before the frame is drawn; snap to the exact pose
			local function snapToPose()
				for _, entry in pairs(spider.Parts) do
					if entry.Target and entry.Root.Parent and tbl12.IsPartOwner(entry.Root) then
						entry.Root.CFrame = entry.Target
					end
				end
			end

			local function updateSpider()
				local _, root, hum = tbl12.Char()
				if not (root and hum and hum.Health > 0) then
					return
				end
				local dt = spider.Dt
				local n = segCount()
				local height = bodyHeight()
				ensurePose(hum)

				local params = rayParams()
				local bodyCF, bodyVel = updateBody(root, hum, params, height, dt)
				local up, fwd = bodyCF.UpVector, bodyCF.LookVector
				local vel = bodyVel - up * bodyVel:Dot(up)
				local walls = on("SpiderWalls", false)
				local restDist = n == 2 and 26 or 38
				local stepDist = n == 2 and 9 or 12
				-- standing still, feet settle onto small changes too (e.g. the Front/Back or Left/Right slider)
				if vel.Magnitude < 1.5 then
					spider.StillTime = (spider.StillTime or 0) + dt
					if spider.StillTime > 0.3 then
						stepDist = 1.5
					end
				else
					spider.StillTime = 0
				end

				-- which diagonal pair (legs 1+3 or 2+4) is mid-step
				local pairBusy = { false, false }
				for i, leg in pairs(spider.Legs) do
					if leg.Step then
						pairBusy[(i - 1) % 2 + 1] = true
					end
				end

				local width = (options.SpiderWidth and options.SpiderWidth.Value or 100) / 100
				local shift = (options.SpiderShift and options.SpiderShift.Value or 0) / 100
				for k, i in ipairs(spider.Active) do
					local angle = LEG_ANGLES[i]
					local outward = bodyCF:VectorToWorldSpace(Vector3.new(math.sin(angle), 0, -math.cos(angle)))
					local hip = bodyCF.Position + outward * 1.5
					-- rest spot: Left/Right scales the stance width, Front/Back slides every foot forward or back,
					-- and it leans into the walk so feet land ahead of the body
					local reachVec = outward * restDist
					local lateral = bodyCF.RightVector * reachVec:Dot(bodyCF.RightVector)
					local spot = hip + (reachVec - lateral) + lateral * width + fwd * (shift * restDist * 0.6) + vel * 0.25
					local rest = findFoot(hip, spot, up, height, params, walls)
					local leg = spider.Legs[i]
					if not leg then
						leg = { Foot = rest }
						spider.Legs[i] = leg
					end
					local pair = (i - 1) % 2 + 1
					if leg.Step then
						leg.Step.T = math.min(1, leg.Step.T + dt / STEP_TIME)
						local t = leg.Step.T
						-- keep chasing the moving target while in the air
						leg.Foot = leg.Step.From:Lerp(rest, t) + up * (math.sin(t * math.pi) * STEP_LIFT)
						if t >= 1 then
							leg.Foot = rest
							leg.Step = nil
						end
					elseif (leg.Foot - rest).Magnitude > stepDist and not pairBusy[3 - pair] then
						leg.Step = { From = leg.Foot, T = 0 }
						pairBusy[pair] = true
					end

					local joints = solveLeg(hip, leg.Foot, n, outward, up)
					local side = outward:Cross(up).Unit
					for s = 1, n do
						local model = spider.Models[(k - 1) * n + s]
						local entry = model and spider.Parts[model]
						if entry and entry.Root.Parent then
							if tbl12.IsPartOwner(entry.Root) then
								placeLadder(entry, joints[s], joints[s + 1], side, dt)
							elseif not spider.Acquiring[entry.Root] then
								entry.Last, entry.Target = nil, nil
								spider.Acquiring[entry.Root] = true
								task.spawn(function()
									tbl12.SNO(entry.Root, 0.25)
									spider.Acquiring[entry.Root] = nil
								end)
							end
						end
					end
				end
			end

			local lastTick = os.clock()
			local function step()
				local now = os.clock()
				spider.Dt = math.clamp(now - lastTick, 1 / 240, 0.1)
				lastTick = now
				updateSpider()
			end

			local function spawnSpider()
				if spider.Spawning then
					return
				end
				spider.Spawning = true
				local generation = spider.Generation
				task.spawn(function()
					local failures = 0
					while not flag11 and spider.Enabled and generation == spider.Generation and #spider.Models < #spider.Active * segCount() and failures < 6 do
						local ladder = tbl12.SpawnToy(LADDER, nil, 1, true)
						local soundPart = ladder and ladder:WaitForChild("SoundPart", 0.5)
						if not (soundPart and tbl12.SNO(soundPart, 0.5)) then
							failures += 1
							if ladder then
								tbl12.DestroyToy(ladder)
							end
							task.wait(0.3)
							continue
						end
						if not (spider.Enabled and generation == spider.Generation) then
							tbl12.DestroyToy(ladder)
							break
						end
						ladder.Name = "SpiderLegRSC" -- protected from Clear like the other RSC toys
						for _, d in ipairs(ladder:GetDescendants()) do
							if d:IsA("BasePart") then
								d.CanCollide = false
								d.CanQuery = false
								d.CanTouch = false
							end
						end
						-- the ladder's parts stream in after it appears; measuring early put the centre off and left
						-- gaps at the knees, so wait until its part count stops changing
						local count, stable = -1, 0
						for _ = 1, 30 do
							local now = #ladder:QueryDescendants("BasePart")
							stable = now == count and stable + 1 or 0
							count = now
							if stable >= 3 then
								break
							end
							task.wait(0.05)
						end
						local box = ladder:GetBoundingBox()
						spider.Parts[ladder] = {
							Root = soundPart,
							Rel = soundPart.CFrame:ToObjectSpace(box),
							Intro = { From = box, T = 0 },
						}
						table.insert(spider.Models, ladder)
					end
					spider.Spawning = false
					if failures >= 6 and spider.Enabled then
						fn18("Spider Legs: couldn't spawn enough ladders", "Spider")
					end
				end)
			end

			local function setSpider(enabled)
				spider.Enabled = enabled
				if enabled then
					lastTick = os.clock()
					tbl12.SetRuntimeConnection("SpiderLegs", RunService.Heartbeat, true, step)
					pcall(RunService.UnbindFromRenderStep, RunService, "HuiGSpiderLegs")
					RunService:BindToRenderStep("HuiGSpiderLegs", Enum.RenderPriority.Last.Value, snapToPose)
					spawnSpider()
				else
					clearSpider()
				end
			end

			local function rebuild()
				if spider.Enabled then
					clearSpider()
					setSpider(true)
				end
			end

