				else
					resultsFrame.Size = UDim2.fromOffset(680, popupHeight)
					resultsFrame.BackgroundTransparency = 0.24
					if resultsStroke then resultsStroke.Transparency = 0.28 end
				end
			elseif wasShowingResults and CommandBarState.IsOpen then
				playCommandTween("results-close", resultsFrame, 0.26, { Size = UDim2.fromOffset(680, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
				if resultsStroke then playCommandTween("results-stroke", resultsStroke, 0.22, { Transparency = 1 }, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out) end
				task.delay(0.24, function()
					if CommandBarState.IsOpen and commandSearch and trim(commandSearch.Text) == "" and resultsFrame then
						resultsFrame.Visible = false
						resultsFrame.Size = UDim2.fromOffset(680, 0)
						resultsFrame.BackgroundTransparency = 0.12
						if resultsStroke then resultsStroke.Transparency = 0.32 end
					end
				end)
			else
				resultsFrame.Visible = false
				resultsFrame.Size = UDim2.fromOffset(680, 0)
				resultsFrame.BackgroundTransparency = 1
				if resultsStroke then resultsStroke.Transparency = 1 end
			end
			for index = 1, maximum do
				local candidate = found[index].Candidate
				table.insert(CommandBarState.VisibleCandidates, candidate)
				local row = Instance.new("TextButton")
				row.Name = "Result_" .. tostring(index)
				row.Size = UDim2.new(1, -24, 0, 48)
				row.Position = UDim2.new(0, 12, 0, 0)
				row.BackgroundColor3 = Color3.fromRGB(62, 62, 62)
