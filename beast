								local ok, rel = pcall(function()
									return danceV2ParseCFrame(cfData):Lerp(danceV2ParseCFrame(nextData), alpha)
								end)
								if ok and rel then
									part.CFrame = base * rel
									part.AssemblyLinearVelocity = Vector3.zero
									part.AssemblyAngularVelocity = Vector3.zero
								end
							end
						end
					end

				end)
			end

			local function danceV2Decode(raw)
