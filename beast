			for index, moduleName in ipairs(actionWheelWheelOrder) do
				if actionWheelSelectedModules[moduleName] then table.insert(positions, index) end
			end
			local otherIndex = rowIndex + delta
			if not positions[rowIndex] or not positions[otherIndex] then return end
			local posA, posB = positions[rowIndex], positions[otherIndex]
			actionWheelWheelOrder[posA], actionWheelWheelOrder[posB] = actionWheelWheelOrder[posB], actionWheelWheelOrder[posA]
