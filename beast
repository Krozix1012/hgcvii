		local function lerpNum(a, b, t)
		    return a + (b - a) * t
		end

		local function lerpColor(a, b, t)
		    return Color3.new(
		        math.clamp(a.R + (b.R - a.R) * t, 0, 1),
		        math.clamp(a.G + (b.G - a.G) * t, 0, 1),
		        math.clamp(a.B + (b.B - a.B) * t, 0, 1)
		    )
		end

