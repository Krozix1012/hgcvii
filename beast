						return
					end
					if openPlayerChooser then
						openPlayerChooser(builtin, text)
						return
					end
					rejectCommandAttempt("No player or location choices are available.")
					return
				end
				dispatchBuiltinCommand(builtin, argument, "rbxassetid://86827880171546")
				return
			end

			if builtin.Handler ~= "togglecontrol" and trim(argument) ~= "" then
				rejectCommandAttempt("Usage: " .. (builtin.Usage or builtin.Command))
				return
			end
			dispatchBuiltinCommand(builtin, argument, "rbxassetid://86827880171546")
		end
