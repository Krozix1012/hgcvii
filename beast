                                end
                            end
                        end

                        local center = originCFrame.Position
                        local radius = 70 + (index % 5) * 8
                        local baseY = center.Y
                        local angularSpeed = 0.18 + (index % 7) * 0.015
                        local angle = (index * 1.37 + math.random() * math.pi) % (2 * math.pi)
                        local connection
                        connection = ForestRunService.Heartbeat:Connect(function(deltaTime)
                            if not ForestActive or not model or not model.Parent then
                                if connection then connection:Disconnect() end
                                return
                            end
                            angle += angularSpeed * deltaTime
                            local bobY = math.sin(angle * 2.3) * 4
                            local x = center.X + math.cos(angle) * radius
                            local z = center.Z + math.sin(angle) * radius
                            local nextAngle = angle + 0.05
                            local nextX = center.X + math.cos(nextAngle) * radius
                            local nextZ = center.Z + math.sin(nextAngle) * radius
                            local position = Vector3.new(x, baseY + bobY, z)
