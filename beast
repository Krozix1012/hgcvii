			elseif candidate.Kind == "Toggle" then
				return object.Value and "ON" or "OFF"
			elseif candidate.Kind == "Dropdown" then
				local value = object.Value
				if typeof(value) == "table" then
					local selected = {}
					for key, active in pairs(value) do
						if active == true then table.insert(selected, tostring(key)) end
					end
					table.sort(selected)
					return #selected > 0 and table.concat(selected, ", ") or "NONE SELECTED"
				end
				return value ~= nil and tostring(value) or "NO VALUE"
			elseif candidate.Kind == "Slider" then
				return tostring(object.Value)
			elseif candidate.Kind == "Input" then
				local value = tostring(object.Value or "")
