            local function bhScaleNS(seq, scale)
                if typeof(seq) ~= "NumberSequence" then return seq end
                local kps = {}
                for _, kp in pairs(seq.Keypoints) do
                    table.insert(kps, NumberSequenceKeypoint.new(kp.Time, kp.Value*scale, kp.Envelope*scale))
                end
                return NumberSequence.new(kps)
            end

            local function bhPrepareModel(model)
                for _, part in pairs(model:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide=false; part.CanTouch=false; part.Anchored=true end
                    if part:IsA("ParticleEmitter") or part:IsA("Trail") then part.Enabled=false end
                    if part:IsA("Sound") then part.Playing=false; part.Volume=0 end
                    if part:IsA("Script") or part:IsA("LocalScript") then part.Disabled=true end
                end
                if model:IsA("Model") then model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart",true) end
            end

            local function bhStopCustomSound(data)
                if data and data.customSound then
                    pcall(function() data.customSound:Stop(); data.customSound:Destroy() end)
                    data.customSound = nil
                end
            end

            local function bhMuteSoundInst(snd)
                if not snd or not snd:IsA("Sound") then return end
                if snd.Name == "HuiG_BH_CustomSound" then return end
                pcall(function() snd.Volume = 0; snd.Playing = false; snd:Stop() end)
            end

            local function bhMuteAllRelated(model, data, holePart)
                local roots = { model }
                if holePart then
                    roots[#roots + 1] = holePart
                    if holePart.Parent then roots[#roots + 1] = holePart.Parent end
                end
                if data and data.holePart then
                    roots[#roots + 1] = data.holePart
                    if data.holePart.Parent then roots[#roots + 1] = data.holePart.Parent end
                end
                for _, root in ipairs(roots) do
                    if root then
                        pcall(function()
                            for _, d in ipairs(root:GetDescendants()) do
                                if d:IsA("Sound") then data.sounds[d] = true; bhMuteSoundInst(d) end
                            end
                            if root:IsA("Sound") then data.sounds[root] = true; bhMuteSoundInst(root) end
                        end)
                    end
                end
            end

            local function bhEnsureCustomSound(model, data)
                if not bh.customSoundEnabled then bhStopCustomSound(data); return end
                local id = tostring(bh.customSoundId or ""):gsub("%s+", "")
                id = id:match("%d+") or id
                if id == "" then bhStopCustomSound(data); return end
                local soundId = "rbxassetid://" .. id
                local host = model
                if model:IsA("Model") then
                    host = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true) or model
                end
                if not data.customSound or not data.customSound.Parent then
                    local s = Instance.new("Sound")
                    s.Name = "HuiG_BH_CustomSound"
                    s.Looped = bh.customSoundLoop ~= false
                    s.RollOffMode = Enum.RollOffMode.InverseTapered
                    s.Parent = host
                    data.customSound = s
                end
                local s = data.customSound
                if s.SoundId ~= soundId then s.SoundId = soundId end
                s.Looped = bh.customSoundLoop ~= false
                s.Volume = tonumber(bh.customSoundVolume) or 1
                if not s.Playing then pcall(function() s:Play() end) end
            end

            local function bhApplyTint(model, data)
                local override = bh.customSoundEnabled and (tostring(bh.customSoundId or ""):match("%d+") ~= nil)
                for _, part in pairs(model:GetDescendants()) do
                    if part:IsA("ParticleEmitter") then
                        if not data.particles[part] then data.particles[part] = part.Color end
                        part.Color = bh.tintEnabled and ColorSequence.new(bh.tintColor) or data.particles[part]
                    elseif part:IsA("Trail") then
                        if not data.trails[part] then data.trails[part] = part.Color end
                        part.Color = bh.tintEnabled and bh.tintColor or data.trails[part]
                    elseif part:IsA("Sound") then
                        if part.Name ~= "HuiG_BH_CustomSound" then
                            data.sounds[part] = true
                            if override or bh.muteSounds then bhMuteSoundInst(part)
                            else part.Volume = bh.soundVolume; if not part.Playing then part:Play() end end
                        end
                    end
                end
                if override or bh.muteSounds then bhMuteAllRelated(model, data, data.holePart) end
                if override then bhEnsureCustomSound(model, data) else bhStopCustomSound(data) end
            end

            local function bhRefresh()
                for model, data in pairs(bhActiveModels) do
                    if model and model.Parent then bhApplyTint(model, data)
                    else bhStopCustomSound(data); bhActiveModels[model] = nil end
                end
            end

            local bhPreloadFolder = Instance.new("Folder")
            bhPreloadFolder.Name = "BHPreloadedModels"
            bhPreloadFolder.Parent = game:GetService("ReplicatedStorage")
            for name, id in pairs(bhAssets) do
                task.spawn(function()
                    local ok, result = pcall(function() return game:GetObjects("rbxassetid://"..id)[1] end)
                    if ok and result then
                        bhPrepareModel(result)
