				danceV2.poseConn = RunService.Heartbeat:Connect(function(dt)
					if not danceV2.enabled or not char.Parent or not hrp.Parent then
						return
					end
					if not hum.PlatformStand then
						hum.PlatformStand = true
					end
					hum.AutoRotate = false

					local cam = workspace.CurrentCamera
					local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
					local yaw = math.atan2(-look.X, -look.Z)
					local posNow = hrp.Position
					local flatNow = Vector3.new(posNow.X, 0, posNow.Z)
					local flatPos = Vector3.new(position.X, 0, position.Z)
					if (flatNow - flatPos).Magnitude > snapDist then
						position = Vector3.new(posNow.X, position.Y, posNow.Z)
					end
					local md = hum.MoveDirection
					if md.Magnitude > 0.01 then
						position = position + Vector3.new(md.X, 0, md.Z) * walkSpeed * dt
					end
					position = Vector3.new(position.X, lockedY, position.Z)

					local base = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
					hrp.CFrame = base
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero

					danceV2.frameTimer = danceV2.frameTimer + dt
					local totalTime = interval * frameCount
					if totalTime <= 0 then
						totalTime = interval
					end
					if danceV2.frameTimer >= totalTime then
						danceV2.frameTimer = danceV2.frameTimer % totalTime
					end
					local phase = danceV2.frameTimer / interval
					local i0 = math.floor(phase) + 1
					local alpha = phase - math.floor(phase)
					if i0 > frameCount then
						i0 = 1
					end
					local i1 = i0 + 1
					if i1 > frameCount then
						i1 = 1
					end
					danceV2.frameIndex = i0

					local f0 = danceV2.activeData.frames[i0]
					local f1 = danceV2.activeData.frames[i1]
					if not f0 or not f0.parts then
