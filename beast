						if k == "EQUALS" or k == "PLUS" then k = "=" end
						if k == "LEFTBRACKET" then k = "[" end
						if k == "RIGHTBRACKET" then k = "]" end
						if k == "BACKSLASH" then k = "\\" end
						if k == "SEMICOLON" then k = ";" end
						if k == "QUOTE" then k = "'" end
						if k == "COMMA" then k = "," end
						if k == "PERIOD" then k = "." end
						if k == "SLASH" then k = "/" end
						if k == "BACKQUOTE" or k == "TILDE" then k = "`" end
						if k == "CAPSLOCK" then k = "CAPS" end
						map[k] = map[k] or {}
