			end
			local hum = char:FindFirstChildOfClass("Humanoid")
			local rag = hum and hum:FindFirstChild("Ragdolled")
			if rag and rag:IsA("BoolValue") and rag.Value == true then
				return true
			end
			return false
		end

		local function rebuildClone(player)
			destroyClone()
			if not preview.World or not player then
				return
			end
			local char = player.Character
			if not char then
				return
			end
			local ok, clone = pcall(function()
				char.Archivable = true
				local c = char:Clone()
				char.Archivable = false
				return c
			end)
			if not ok or not clone then
				return
			end
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BaseScript") or d:IsA("Sound") or d:IsA("ForceField") then
					pcall(function()
						d:Destroy()
					end)
				elseif d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanTouch = false
					d.CanQuery = false
				elseif d:IsA("Humanoid") then
					pcall(function()
						d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
					end)
				end
			end
			local floor = Instance.new("Part")
			floor.Name = "PV_Floor"
			floor.Anchored = true
			floor.CanCollide = false
			floor.Size = Vector3.new(40, 1, 40)
			floor.Color = Color3.fromRGB(35, 38, 42)
			floor.Material = Enum.Material.SmoothPlastic
			local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
			if hrp then
				floor.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.5, hrp.Position.Z)
			end
			floor.Parent = preview.World
			clone.Parent = preview.World
			preview.CharClone = clone
			preview.Floor = floor
		end

		local function syncClone(player)
			local char = player and player.Character
			local clone = preview.CharClone
			if not char or not clone or not clone.Parent then
				rebuildClone(player)
				return
			end
			for _, part in ipairs(char:GetChildren()) do
				if part:IsA("BasePart") then
					local cp = clone:FindFirstChild(part.Name)
					if cp and cp:IsA("BasePart") then
						cp.CFrame = part.CFrame
					end
				elseif part:IsA("Accessory") then
					local h = part:FindFirstChild("Handle")
					local ca = clone:FindFirstChild(part.Name)
					local ch = ca and ca:FindFirstChild("Handle")
					if h and ch and h:IsA("BasePart") and ch:IsA("BasePart") then
						ch.CFrame = h.CFrame
					end
				end
			end
			if preview.Floor and preview.Floor.Parent then
				local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
				if hrp then
					preview.Floor.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.5, hrp.Position.Z)
				end
			end
		end

		local function updateCamera(player)
			if not preview.Camera then
