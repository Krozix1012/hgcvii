						if keyBadgeTitle then keyBadgeTitle.Text = "PREFIX"; keyBadgeTitle.Visible = true; keyBadgeTitle.TextColor3 = Color3.fromRGB(180,180,200); keyBadgeTitle.Position = UDim2.new(0,0,0,3) end
						if keyBadgeValue then keyBadgeValue.Text = tostring(CommandBarState.Prefix or "."); keyBadgeValue.TextSize = 18; keyBadgeValue.Position = UDim2.new(0,0,0,16); keyBadgeValue.Size = UDim2.new(1,0,0,20); keyBadgeValue.TextXAlignment = Enum.TextXAlignment.Center; keyBadgeValue.TextYAlignment = Enum.TextYAlignment.Center; keyBadgeValue.Visible = true; keyBadgeValue.TextTransparency = 0 end
