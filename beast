		local function findPlayerByQuery(query)
			if typeof(query) == "Instance" and query:IsA("Player") then return query end
			local raw = trim(query)
			if raw == "" then return nil, "Enter a player name." end
			local PlayersService = game:GetService("Players")
			local localPlayer = PlayersService.LocalPlayer
			local lowered = raw:gsub("^@", ""):lower()
			if lowered == "me" or lowered == "self" then return localPlayer end
			local all = PlayersService:GetPlayers()
			for _, player in ipairs(all) do
				if player.Name:lower() == lowered then return player end
			end
			for _, player in ipairs(all) do
				if player.DisplayName:lower() == lowered then return player end
			end
			local matches = {}
			for _, player in ipairs(all) do
				if player.Name:lower():sub(1, #lowered) == lowered or player.DisplayName:lower():sub(1, #lowered) == lowered then
					table.insert(matches, player)
				end
			end
			if #matches == 1 then return matches[1] end
			if #matches > 1 then return nil, "Player name is ambiguous; type more characters." end
			return nil, "Player not found: " .. raw
		end

		local function getTeleportLocations()
			local result, seen = {}, {}
			local function add(value)
				if typeof(value) == "Instance" and not seen[value] then
					seen[value] = true
					table.insert(result, value)
				end
			end
			for _, value in ipairs((tbl7 and tbl7.TeleportLocations) or {}) do add(value) end
			local dropdown = options and options.TeleportToDropdown
