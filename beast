				STEER_GAIN = 1.2 - 0.4 * soft / 100
			end

			local function applySeatHeight()
				if car and car.driverWeld and car.driverWeld.Parent then
					car.driverWeld.C0 = car.driverBase * CFrame.new(0, -DRIVER_LOWER, 0)
				end
			end
			local controls = nil

			local function getMoveVector()
				local ok, move = pcall(function()
					return controls:GetMoveVector()
				end)
				if ok and typeof(move) == "Vector3" and move.Magnitude > 0.05 then
					return move
				end
				local function key(k)
					return UserInputService:IsKeyDown(k) and 1 or 0
				end
				local keys = Vector3.new(key(Enum.KeyCode.D) - key(Enum.KeyCode.A), 0, key(Enum.KeyCode.S) - key(Enum.KeyCode.W))
				local seat = car and car.seat
				if keys.Magnitude == 0 and seat and seat:IsA("VehicleSeat") then
					return Vector3.new(seat.SteerFloat, 0, -seat.ThrottleFloat)
				end
				return keys
			end

			-- The jet is flown by the jet code (Peak Visuals block, which exposes _JET.spawn/unmount); the garage starts
			-- and ends it and keeps its Spawn toggle in step when you get in or out some other way (keybind, jump, death)
			local jetBusy, jetToggleSync = false, false
			local function unmountJet()
				if _JET and _JET.mounted and _JET.unmount then
					jetBusy = true
					_JET.unmount()
					jetBusy = false
				end
			end
			tbl12.OnJetMounted = function(on)
				HuiGSync.SetLocal("jet", on)
				local t = toggles.FunVehicleSpawn
				if not jetBusy and t and t.Value ~= on and val("FunVehicleType", "Car") == "Jet" then
					jetToggleSync = true
					t:SetValue(on)
					jetToggleSync = false
				end
			end

			local function despawnVehicle()
				unmountJet()
				if not car then
					return
				end
				local c = car
				car = nil
				for _, marker in pairs(CAR_MARKERS) do
					HuiGSync.SetLocal(marker, false)
				end
				HuiGSync.SetLocal("drift", false)
				c.conn:Disconnect()
				if c.sitTrack then
					c.sitTrack:Stop()
				end
				c.model:Destroy()
				c.root:Destroy()
				if c.humanoid.Parent then
					c.humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
					c.humanoid.AutoRotate = c.autoRotate
					c.humanoid.Sit = false
				end
			end

			local function stopVehicle()
				despawnVehicle()
				task.defer(function()
					toggles.FunVehicleSpawn:SetValue(false)
				end)
			end

			-- A-Chassis cars keep each wheel under a "Wheels" folder; otherwise take parts named like wheels per corner.
			local function findWheelGroups(model, frame)
				local groups = {}
				local container = model:FindFirstChild("Wheels", true)
				if container then
					for _, w in ipairs(container:GetChildren()) do
						local parts = w:IsA("BasePart") and { w } or {}
						for _, d in ipairs(w:GetDescendants()) do
							if d:IsA("BasePart") then
								table.insert(parts, d)
							end
						end
						if #parts > 0 then
							table.insert(groups, { root = w, parts = parts })
						end
					end
				end
				if #groups >= 3 then
					return groups
				end
				local corners = {}
				for _, d in ipairs(model:GetDescendants()) do
					local n = d:IsA("BasePart") and d.Name:lower() or ""
					local wheelish = n:find("wheel") or n:find("tire") or n:find("tyre") or n:find("^rim") or n:find("rim$")
					if wheelish and not n:find("steer") then
						local l = frame:PointToObjectSpace(d.Position)
						local key = (l.X > 0 and "R" or "L") .. (l.Z < 0 and "F" or "B")
						corners[key] = corners[key] or { root = model, parts = {} }
						table.insert(corners[key].parts, d)
					end
				end
				groups = {}
				for _, g in pairs(corners) do
					table.insert(groups, g)
				end
				return groups
			end

			-- calipers and other "Fixed" wheel parts steer and travel with the wheel but don't spin
			local function isFixedPart(part, stop)
				local node = part
				while node and node ~= stop do
					local n = node.Name:lower()
					if n:find("fixed") or n:find("caliper") or n:find("brake") then
						return true
					end
					node = node.Parent
				end
				return false
			end

			local function makeHolder(name, cf, parent)
				local h = Instance.new("Part")
				h.Name = name
				h.Size = Vector3.new(0.2, 0.2, 0.2)
				h.Transparency = 1
				h.CanCollide = false
				h.CanQuery = false
				h.CanTouch = false
				h.Massless = true
				h.CFrame = cf
				h.Parent = parent
				return h
			end

			-- tyre smoke under a wheel: the car's own smoke emitter when it brought one (`template`), else a plain white one
			local function makeSmoke(knuckle, radius, template)
				local attachment = Instance.new("Attachment")
				attachment.Position = Vector3.new(0, -radius, 0)
				attachment.Parent = knuckle
				if template then
					local own = template:Clone()
					own.Enabled = false
					own.Parent = attachment
					return own
				end
				local smoke = Instance.new("ParticleEmitter")
				smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
				smoke.Color = ColorSequence.new(Color3.fromRGB(225, 225, 225))
				smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 8) })
				smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
				smoke.Lifetime = NumberRange.new(1.2, 2.4)
				smoke.Speed = NumberRange.new(2, 5)
				smoke.SpreadAngle = Vector2.new(35, 35)
				smoke.Rotation = NumberRange.new(0, 360)
				smoke.RotSpeed = NumberRange.new(-40, 40)
				smoke.Acceleration = Vector3.new(0, 3, 0)
				smoke.Drag = 1.5
				smoke.LightInfluence = 0.8
				smoke.EmissionDirection = Enum.NormalId.Top
				smoke.Enabled = false
				smoke.Parent = attachment
				return smoke
			end

			-- a wheel's hub (its biggest visible part) in `frameCF` space, and its radius
			local function wheelHub(g, frameCF)
				local main, best = nil, -1
				for _, p in ipairs(g.parts) do
					local volume = p.Size.X * p.Size.Y * p.Size.Z
					if p.Transparency < 1 and volume > best then
						main, best = p, volume
					end
				end
				main = main or g.parts[1]
				return frameCF:PointToObjectSpace(main.Position), math.clamp(math.max(main.Size.X, main.Size.Y, main.Size.Z) / 2, 0.8, 4)
			end

			-- What an A-Chassis car brings along: its engine sample and pitch range (the Rev sound's SetPitch/SetRev, which
			-- its sound plugin uses as pitch = SetPitch + SetRev * rpm / redline), a supercharger whine and blow-off valve,
			-- and its tyre-smoke emitter. Read before carFrame strips the plugin scripts these live under.
			local function carProfile(model)
				local profile = {}
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("Sound") and d.SoundId ~= "" then
						local setRev, setPitch = d:FindFirstChild("SetRev"), d:FindFirstChild("SetPitch")
						if d.Name == "Rev" and setRev and not profile.rev then
							profile.rev = { id = d.SoundId, pitch = setPitch and setPitch.Value or 0.1, span = setRev.Value }
						elseif d.Name == "Whine" and d.Parent.Name:find("Boost") then
							profile.whine = d.SoundId
						elseif d.Name == "BOV" then
							profile.bov = d.SoundId
						end
					elseif d:IsA("ParticleEmitter") and d.Name == "Smoke" and d.Parent.Name == "Smoke_FE" and not profile.smoke then
						profile.smoke = d:Clone()
					end
				end
				return profile
			end

			-- The car's own exhaust backfire (flames, flash and pops when you lift off at high revs) and brake/reverse
			-- lights, found by their A-Chassis names. Returns update(dt, revs 0-1, throttle, braking, reversing, soundOn).
			local function makeCarFx(model)
				local fire, flash, pops, brake, reverse = {}, {}, {}, {}, {}
				local top = #model:GetFullName() + 1
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Sound") then
						local path = d:GetFullName():sub(top):lower()
						if path:find("backfire") or path:find("bflight") or path:find("bf_light") or path:find("%.bf%d") then
							if d:IsA("ParticleEmitter") then
								d.Enabled = false
								table.insert(fire, d)
							elseif d:IsA("Light") then
								d.Enabled = false
								table.insert(flash, d)
							else
								d.Volume = math.min(d.Volume, 1.5)
								table.insert(pops, d)
							end
						elseif d:IsA("Light") and path:find("brake") then
							table.insert(brake, d)
						elseif d:IsA("Light") and path:find("reverse") then
							table.insert(reverse, d)
						end
					end
				end
				local lastThrottle, cooldown, flashLeft = 0, 0, 0
				return function(dt, revs, throttle, braking, reversing, soundOn)
					for _, l in ipairs(brake) do
						l.Enabled = braking
					end
					for _, l in ipairs(reverse) do
						l.Enabled = reversing
					end
					cooldown -= dt
					flashLeft -= dt
					if lastThrottle > 0 and throttle <= 0 and revs > 0.55 and cooldown <= 0 and #fire + #pops > 0 then
						cooldown, flashLeft = 0.6, 0.15
						local pop = pops[math.random(math.max(#pops, 1))]
						if pop and soundOn then
							pop:Play()
						end
					end
					lastThrottle = throttle
					local lit = flashLeft > 0
					for _, e in ipairs(fire) do
						e.Enabled = lit
					end
					for _, l in ipairs(flash) do
						l.Enabled = lit
					end
				end
			end

			-- Engine and tyre sounds on `parent` (3D, and gone with it). With a car's `profile.rev` it plays that car's own
			-- engine sample (plus its supercharger whine and blow-off valve); otherwise an Aston Martin Valkyrie V12 sample
			-- set, where like racing games the two samples either side of the RPM are crossfaded and pitched. Returns
			-- update(dt, forward, throttle, grounded, drifting, scrub, enabled) -> revs 0-1. Your car and other HuiG
			-- players' use it.
			local function makeEngineSound(parent, profile)
				local function carSound(id, looped)
					local sound = Instance.new("Sound")
					sound.SoundId = id
					sound.Looped = looped ~= false
					sound.Volume = 0
					sound.RollOffMaxDistance = 250
					sound.Parent = parent
					return sound
				end
				local function bank(list)
					local out = {}
					for _, entry in ipairs(list) do
						local sound = carSound("rbxassetid://" .. entry[2])
						sound:Play()
						table.insert(out, { rpm = entry[1], sound = sound })
					end
					return out
				end
				local own = profile and profile.rev
				local onBank, offBank, idleSound, revSound, whine, bov
				if own then
					revSound = carSound(own.id)
					revSound:Play()
					whine = profile.whine and carSound(profile.whine)
					if whine then
						whine:Play()
					end
					bov = profile.bov and carSound(profile.bov, false)
				else
					onBank, offBank = bank(ENGINE_ON), bank(ENGINE_OFF)
					idleSound = carSound("rbxassetid://" .. ENGINE_IDLE[2])
					idleSound:Play()
				end
				local skidSound = carSound(SKID_SOUND)
				local rpm, revLoad = IDLE_RPM, 0

				-- gives the two samples either side of the current RPM their share of `volume`, pitched to match
				local function mixBank(list, volume)
					for _, entry in ipairs(list) do
						entry.sound.Volume = 0
					end
					local below, above, t = list[1], list[1], 0
					if rpm >= list[#list].rpm then
						below, above = list[#list], list[#list]
					else
						for i = 1, #list - 1 do
							if rpm >= list[i].rpm and rpm < list[i + 1].rpm then
								below, above = list[i], list[i + 1]
								t = (rpm - below.rpm) / (above.rpm - below.rpm)
								break
							end
						end
					end
					below.sound.Volume = volume * (1 - t)
					above.sound.Volume += volume * t
					below.sound.PlaybackSpeed = math.clamp(rpm / below.rpm, 0.5, 2)
					above.sound.PlaybackSpeed = math.clamp(rpm / above.rpm, 0.5, 2)
				end

				return function(dt, forward, throttle, grounded, drifting, scrub, enabled)
					-- RPM from a 6-speed box: first gear revs from idle, later gears pick up after the shift drop
					local ratio = math.clamp(math.abs(forward) / TOP_SPEED, 0, 1)
					local gear = math.min(GEARS, math.floor(ratio * GEARS) + 1)
					local inGear = ratio * GEARS - (gear - 1)
					local gearFloor = gear == 1 and IDLE_RPM or SHIFT_RPM
					local wantRpm = gearFloor + inGear * (REDLINE - gearFloor)
					if throttle ~= 0 and (not grounded or drifting or math.abs(forward) < 3) then
						-- free-revving: in the air, spinning the rears in a drift, or launching from a stop
						wantRpm = math.max(wantRpm, REDLINE * (drifting and 0.85 or 0.75))
					end
					rpm += (wantRpm - rpm) * math.min(1, 9 * dt)
					local master = enabled and 0.6 or 0
					local revs = rpm / REDLINE
					if own then
						revSound.PlaybackSpeed = own.pitch + own.span * revs
						revSound.Volume = master * (0.55 + 0.45 * revLoad)
						if whine then
							whine.PlaybackSpeed = 0.5 + 1.5 * revs
							whine.Volume = master * 0.3 * revLoad * revs
						end
						-- the blow-off valve vents when you lift off a boosted engine
						if bov and enabled and throttle <= 0 and revLoad > 0.8 and revs > 0.45 and not bov.IsPlaying then
							bov.Volume = 0.6
							bov:Play()
						end
					else
						local idleShare = math.clamp((ENGINE_ON[1][1] - rpm) / (ENGINE_ON[1][1] - IDLE_RPM), 0, 1)
						mixBank(onBank, master * revLoad * (1 - idleShare))
						mixBank(offBank, master * (1 - revLoad) * (1 - idleShare))
						idleSound.Volume = master * idleShare
						idleSound.PlaybackSpeed = math.clamp(rpm / ENGINE_IDLE[1], 0.5, 2)
					end
					-- tyres squeal with `scrub`: the sideways slide, or a locked rear wheel dragging
					local wantSkid = enabled and math.clamp((scrub - 6) / 25, 0, 1) * 0.7 or 0
					skidSound.Volume += (wantSkid - skidSound.Volume) * math.min(1, 10 * dt)
					skidSound.PlaybackSpeed = 0.9 + math.clamp(scrub / 60, 0, 0.25)
					if skidSound.Volume > 0.01 and not skidSound.IsPlaying then
						skidSound:Play()
					elseif skidSound.Volume <= 0.01 and skidSound.IsPlaying then
						skidSound:Stop()
					end
					revLoad += ((throttle > 0 and 1 or 0) - revLoad) * math.min(1, 10 * dt)
					return revs
				end
			end

			-- strip the chassis physics (suspension, motors, thrusters, scripts) and work out the driver frame: the seat
			-- facing its LookVector, or the bounding box turned around when there's no seat. Shared by your own car and
			-- the copies of other players' cars, so both line up with the driver the same way.
			local function carFrame(model)
				local seat = nil
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("BodyMover") or d:IsA("Script") or d:IsA("LocalScript") then
						d:Destroy()
					elseif d:IsA("VehicleSeat") or d:IsA("Seat") then
						if not seat or (d:IsA("VehicleSeat") and not seat:IsA("VehicleSeat")) then
							seat = d
						end
					end
				end
				local frame
				if seat then
					local flat = Vector3.new(seat.CFrame.LookVector.X, 0, seat.CFrame.LookVector.Z).Unit
					frame = CFrame.lookAt(seat.Position, seat.Position + flat)
				else
					local box = model:GetBoundingBox()
					frame = CFrame.new(box.Position) * box.Rotation * CFrame.Angles(0, math.pi, 0)
				end
				return seat, frame
			end

			-- Other HuiG players' cars (HuiG Sync): the car they picked, anchored and posed from their body every frame (the
			-- driver is welded at a fixed offset above the driver point, so the body alone places the car). Its engine,
			-- backfire and lights run from how fast the body moves; their drift marker lights the rear tyre smoke.
			local remoteCarTemplates = {}
			for carName, marker in pairs(CAR_MARKERS) do
				HuiGSync.Register(marker, function(player)
					if not remoteCarTemplates[carName] then
						remoteCarTemplates[carName] = loadAsset(VEHICLES.Car[carName])
					end
					if not remoteCarTemplates[carName] then
						return nil
					end
					local model = remoteCarTemplates[carName]:Clone()
					local profile = carProfile(model)
					local _, frame = carFrame(model)
					local smokes = {}
					for _, g in ipairs(findWheelGroups(model, frame)) do
						local localPos, radius = wheelHub(g, frame)
						if localPos.Z >= 0 then
							table.insert(smokes, makeSmoke(makeHolder("HuiGSmoke", frame * CFrame.new(localPos), model), radius, profile.smoke))
						end
					end
					local speaker = makeHolder("HuiGEngine", frame, model)
					for _, d in ipairs(model:GetDescendants()) do
						if d:IsA("BasePart") then
							d.Anchored = true
							d.CanCollide = false
							d.CanQuery = false
							d.CanTouch = false
						elseif d:IsA("Seat") or d:IsA("VehicleSeat") then
							d.Disabled = true
						end
					end
					local engineSound = makeEngineSound(speaker, not VALKYRIE_SOUND[carName] and profile or nil)
					local carFx = makeCarFx(model)
					local toPivot = frame:ToObjectSpace(model:GetPivot())
					local driverToCar = CFrame.new(0, -(SEAT_DROP - DRIVER_LOWER), 0)
					model.Name = "HuiGRemoteCar"
					model.Parent = workspace
					local lastPos, vel, lastForward, accel = nil, Vector3.zero, 0, 0
					local conn = RunService.RenderStepped:Connect(function(dt)
						local character = player.Character
						local hrp = character and character:FindFirstChild("HumanoidRootPart")
						if not hrp or dt <= 0 then
							return
						end
						local cf = hrp.CFrame
						model:PivotTo(cf * driverToCar * toPivot)
						-- their speed, smoothed: replicated positions arrive unevenly
						if lastPos then
							vel += ((cf.Position - lastPos) / dt - vel) * math.min(1, 6 * dt)
						end
						lastPos = cf.Position
						local forward = vel:Dot(cf.LookVector)
						local slide = (vel - cf.LookVector * forward).Magnitude
						accel += ((forward - lastForward) / dt - accel) * math.min(1, 6 * dt)
						lastForward = forward
						local drifting = HuiGSync.Has(player, "drift")
						local smokeOn = drifting and val("FunCarSmoke", true)
						for _, smoke in ipairs(smokes) do
							smoke.Enabled = smokeOn
							smoke.Rate = 30 + slide * 4
						end
						local scrub = drifting and math.max(slide, math.abs(forward)) or slide
						local soundOn = val("FunCarSounds", true)
						local throttle = accel > 1 and 1 or 0
						local revs = engineSound(dt, forward, throttle, true, drifting, scrub, soundOn)
						carFx(dt, revs, throttle, accel < -15 and forward > 1, forward < -1, soundOn)
					end)
					return function()
						conn:Disconnect()
						model:Destroy()
					end
				end)
			end
			-- Other HuiG players' jets: the F-22 anchored where their jet sits (welded 5 below and 10 behind their body),
			-- their character hidden inside it like your own is, and the engine sounds from how fast they fly
			local remoteJetTemplate = nil
			HuiGSync.Register("jet", function(player)
				if not remoteJetTemplate then
					remoteJetTemplate = loadAsset(JET_ASSET)
				end
				if not remoteJetTemplate then
					return nil
				end
				local model = remoteJetTemplate:Clone()
				model.Name = "HuiGRemoteJet" -- not the asset's own name: the jet code deletes that one by name
				local misc = model:FindFirstChild("Misc")
				local gear = misc and misc:FindFirstChild("LandingGear")
				if gear then
					gear:Destroy()
				end
				local speaker = makeHolder("HuiGJetSound", model:GetPivot(), model)
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Anchored = true
						d.CanCollide = false
						d.CanQuery = false
						d.CanTouch = false
					elseif d:IsA("LuaSourceContainer") then
						d:Destroy()
					end
				end
				local function jetSound(id)
					local sound = Instance.new("Sound")
					sound.SoundId = id
					sound.Looped = true
					sound.Volume = 0
					sound.RollOffMaxDistance = 600
					sound.Parent = speaker
					sound:Play()
					return sound
				end
				-- the jet code's flying and boost sounds
				local fly, boost = jetSound("rbxassetid://95345594297694"), jetSound("rbxassetid://96899873315260")
				model.Parent = workspace
				local hidden = {}
				local lastPos, vel = nil, Vector3.zero
				local conn = RunService.RenderStepped:Connect(function(dt)
					local character = player.Character
					local hrp = character and character:FindFirstChild("HumanoidRootPart")
					if not hrp or dt <= 0 then
						return
					end
					model:PivotTo(hrp.CFrame * CFrame.new(0, -5, 10))
					for _, d in ipairs(character:GetDescendants()) do
						if d:IsA("BasePart") and d.LocalTransparencyModifier < 1 then
							hidden[d] = true
							d.LocalTransparencyModifier = 1
						end
					end
					if lastPos then
						vel += ((hrp.Position - lastPos) / dt - vel) * math.min(1, 6 * dt)
					end
					lastPos = hrp.Position
					-- full throttle is 360 studs/s; the boost multiplies it. Volumes follow your own jet sound settings.
					local settings = _JET or {}
					local speed = vel.Magnitude
					local throttle = math.clamp(speed / 360, 0, 1)
					local flyVol = settings.flyingSoundOn ~= false and throttle * (settings.flyingVolMax or 0.7) or 0
					local boostVol = (settings.boostSoundOn ~= false and speed > 420) and (settings.boostVolMax or 0.7) or 0
					fly.Volume += (flyVol - fly.Volume) * math.min(1, 2.8 * dt)
					fly.PlaybackSpeed = 0.6 + throttle * 0.8
					boost.Volume += (boostVol - boost.Volume) * math.min(1, 2.8 * dt)
					boost.PlaybackSpeed = 0.8 + math.clamp(speed / 300, 0, 1) * 0.7
				end)
				return function()
					conn:Disconnect()
					model:Destroy()
					for part in pairs(hidden) do
						if part.Parent then
							part.LocalTransparencyModifier = 0
						end
					end
				end
			end)
			local vehicleToken = 0
			local function spawnVehicle()
				despawnVehicle()
				vehicleToken += 1
				local token = vehicleToken
				if val("FunVehicleType", "Car") == "Jet" then
					if not (_JET and _JET.spawn) then
						notify("The jet isn't loaded.")
						stopVehicle()
						return
					end
					-- switching the type fires this twice in one frame (the list changes, then the pick): only the last spawns
					task.wait()
					if token ~= vehicleToken then
						return
					end
					jetBusy = true
					_JET.spawn() -- loads the F-22 and gets in; yields
					jetBusy = false
					if token ~= vehicleToken or not val("FunVehicleSpawn", false) then
						unmountJet()
					elseif not _JET.mounted then
						notify("Couldn't load the jet")
						stopVehicle()
					end
					return
				end
				local root, humanoid, character = getRoot()
				if not (root and humanoid) then
					return
				end
				local list = VEHICLES[val("FunVehicleType", "Car")] or {}
				local name = val("FunVehicle", nil)
				local model = list[name] and loadAsset(list[name])
				if token ~= vehicleToken or not val("FunVehicleSpawn", false) or root.Parent ~= character then
					if model then
						model:Destroy()
					end
					return
				end
				if not model then
					notify("Couldn't load " .. tostring(name))
					stopVehicle()
					return
				end

				if not controls then
					pcall(function()
						controls = require(localPlayer.PlayerScripts:FindFirstChild("PlayerModule")):GetControls()
					end)
				end

				local profile = carProfile(model)
				local seat, frame = carFrame(model)

				-- ride height and footprint from visible parts near the driver, so display stands or stray props don't count
				local lowest, lo, hi = nil, nil, nil
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("BasePart") and d.Transparency < 1 then
						local l = frame:PointToObjectSpace(d.Position)
						if Vector3.new(l.X, 0, l.Z).Magnitude < 15 then
							local bottom = d.Position.Y - d.Size.Y / 2
							lowest = lowest and math.min(lowest, bottom) or bottom
							lo = lo and lo:Min(l) or l
							hi = hi and hi:Max(l) or l
						end
					end
				end
				local rideHeight = frame.Y - (lowest or frame.Y - 2)
				if rideHeight < 0.5 or rideHeight > 6 then
					rideHeight = 2
				end

				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { character, model }

				-- Only solid, fixed geometry counts as road. Without this the rays landed on things that follow you
				-- (FTAP's PlayerCharacterLocationDetector, held toys, other players), lifted the car onto them, they
				-- followed it up, and the car climbed forever.
				local function solidCast(origin, dir)
					for _ = 1, 8 do
						local hit = workspace:Raycast(origin, dir, params)
						if not hit then
							return nil
						end
						local p = hit.Instance
						if p:IsA("Terrain") or (p.Anchored and p.CanCollide and p.Name ~= "PlayerCharacterLocationDetector") then
							return hit
						end
						params:AddToFilter(p)
					end
					return nil
				end

				local look = root.CFrame.LookVector
				local yaw = math.atan2(-look.X, -look.Z)
				local start = root.Position
				local ground = solidCast(start + Vector3.new(0, 2, 0), Vector3.new(0, -50, 0))
				local pos = Vector3.new(start.X, (ground and ground.Position.Y or start.Y - 3) + rideHeight, start.Z)

				local carRoot = Instance.new("Part")
				carRoot.Name = "HuiGVehicleRoot"
				carRoot.Size = Vector3.one
				carRoot.Transparency = 1
				carRoot.CanCollide = false
				carRoot.CanQuery = false
				carRoot.CanTouch = false
				carRoot.CFrame = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
				carRoot.Parent = workspace
				pcall(model.PivotTo, model, carRoot.CFrame * frame:ToObjectSpace(model:GetPivot()))

				-- wheels: knuckle (suspension + steering) -> spinner (rolling), each on a Weld we drive every frame
				local wheels, holderOf = {}, {}
				for _, g in ipairs(findWheelGroups(model, carRoot.CFrame)) do
					local localPos, radius = wheelHub(g, carRoot.CFrame)
					local hubCF = carRoot.CFrame * CFrame.new(localPos)
					local knuckle = makeHolder("HuiGKnuckle", hubCF, carRoot)
					local spinner = makeHolder("HuiGSpinner", hubCF, carRoot)
					local kWeld = Instance.new("Weld")
					kWeld.Part0 = carRoot
					kWeld.Part1 = knuckle
					kWeld.C0 = CFrame.new(localPos)
					kWeld.Parent = knuckle
					local sWeld = Instance.new("Weld")
					sWeld.Part0 = knuckle
					sWeld.Part1 = spinner
					sWeld.Parent = spinner
					for _, p in ipairs(g.parts) do
						holderOf[p] = isFixedPart(p, g.root) and knuckle or spinner
					end
					local front = localPos.Z < 0
					table.insert(wheels, {
						localPos = localPos,
						radius = radius,
						front = front,
						kWeld = kWeld,
						sWeld = sWeld,
						smoke = not front and makeSmoke(knuckle, radius, profile.smoke) or nil,
						spin = 0,
						susp = 0,
					})
				end

				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Anchored = false
						d.CanCollide = false
						d.CanQuery = false
						d.CanTouch = false
						d.Massless = true
						local wc = Instance.new("WeldConstraint")
						wc.Part0 = holderOf[d] or carRoot
						wc.Part1 = d
						wc.Parent = carRoot
					end
				end
				model.Parent = workspace

				-- ground probes: the wheels when there are front and rear ones, else four corners of the body
				local probes, frontZ, rearZ, frontN, rearN = {}, 0, 0, 0, 0
				for _, w in ipairs(wheels) do
					if w.front then
						frontZ, frontN = frontZ + w.localPos.Z, frontN + 1
					else
						rearZ, rearN = rearZ + w.localPos.Z, rearN + 1
					end
				end
				local wheelbase = 9
				lo, hi = lo or Vector3.new(-3, 0, -5), hi or Vector3.new(3, 0, 5)
				if frontN > 0 and rearN > 0 then
					probes = wheels
					wheelbase = math.clamp(rearZ / rearN - frontZ / frontN, 4, 20)
				else
					for _, x in ipairs({ lo.X * 0.8, hi.X * 0.8 }) do
						for _, z in ipairs({ lo.Z * 0.7, hi.Z * 0.7 }) do
							table.insert(probes, { localPos = Vector3.new(x, -rideHeight, z), radius = 0 })
						end
					end
				end

				car = { model = model, root = carRoot, seat = seat, humanoid = humanoid, autoRotate = humanoid.AutoRotate }

				local engineSound = makeEngineSound(carRoot, not VALKYRIE_SOUND[name] and profile or nil) -- 3D, gone with the car
				local carFx = makeCarFx(model)
				humanoid.AutoRotate = false
				-- Space is the handbrake/drift key while driving, so it must not jump out of the car
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)

				-- play the sit pose ourselves: without it the legs hang straight down through the floor
				local animator = humanoid:FindFirstChildOfClass("Animator")
				if animator then
					local animate = character:FindFirstChild("Animate")
					local sitFolder = animate and animate:FindFirstChild("sit")
					local source = sitFolder and sitFolder:FindFirstChildOfClass("Animation")
					local anim = Instance.new("Animation")
					anim.AnimationId = source and source.AnimationId or SIT_ANIMS[humanoid.RigType.Name]
					pcall(function()
						local track = animator:LoadAnimation(anim)
						track.Priority = Enum.AnimationPriority.Action
						track.Looped = true
						track:Play(0.1)
						car.sitTrack = track
					end)
				end

				local vel, vy, steer, steerInput = Vector3.zero, 0, 0, 0
				local grounded, lastForward = false, 0
				local lastGroundY, groundGrace = 0, 0
				local chassisPitch, chassisRoll = 0, 0
				local bodyPitch, bodyPitchV, bodyRoll, bodyRollV, heave, heaveV = 0, 0, 0, 0, 0, 0
				local seated, welded = false, false
				local driftHold = 0 -- keeps the drift marker on through short gaps, so other players' smoke doesn't flicker

				local function stepCar(dt)
					dt = math.min(dt, 1 / 20)
					readSettings()
					if root.Parent ~= character or humanoid.Health <= 0 or not carRoot.Parent then
						stopVehicle()
						return
					end
					if seated and humanoid.SeatPart ~= seat then
						-- knocked out of the seat
						stopVehicle()
						return
					end
					if welded then
						humanoid.Sit = true
					end

					local move = getMoveVector()
					local throttle, steerIn = -move.Z, move.X
					-- not Humanoid.Jump: with jumping disabled it can stay true, which held the handbrake forever
					local handbrake = UserInputService:IsKeyDown(Enum.KeyCode.Space)
					local heading = CFrame.Angles(0, yaw, 0).LookVector
					local forward = vel:Dot(heading)
					local lateral = vel - heading * forward
					local sign = forward >= 0 and 1 or -1
					-- total speed, not speed along the heading: past ~90° of slide the heading component is ~0 and the
					-- drift used to switch itself off (full grip + handbrake), stopping the car dead
					local speed = vel.Magnitude
					local drifting = grounded and val("FunVehicleDrift", false) and handbrake and speed > 12
					local lastYaw = yaw
					driftHold = drifting and 0.3 or driftHold - dt
					HuiGSync.SetLocal("drift", driftHold > 0)

					if grounded then
						-- engine pulls less as you near top speed; S brakes first, then reverses
						if drifting then
							-- engine always pushes where the car points, whatever way it is sliding
							local pull = math.max(0.25, 1 - math.clamp(speed / TOP_SPEED, 0, 1) ^ 2)
							forward = math.min(forward + ENGINE * throttle * pull * dt, math.max(forward, TOP_SPEED))
						elseif throttle > 0 then
							if forward < -0.5 then
								forward = math.min(0, forward + BRAKE * dt)
							else
								-- the pull never drops below 25%, so the car really reaches Max Speed and stops there
								local pull = math.max(0.25, 1 - (math.max(forward, 0) / TOP_SPEED) ^ 2)
								forward = math.min(forward + ENGINE * throttle * pull * dt, math.max(forward, TOP_SPEED))
							end
						elseif throttle < 0 then
							if forward > 0.5 then
								forward = math.max(0, forward - BRAKE * dt)
							else
								forward = math.max(-REVERSE_SPEED, forward + ENGINE * 0.5 * throttle * dt)
							end
						end
						forward -= workspace.Gravity * SLOPE_GRAVITY * math.sin(chassisPitch) * dt
						-- drag only while coasting/braking: on the throttle it used to cap the car at ~57 of 76 km/h
						if not drifting and not (throttle > 0 and forward >= -0.5) then
							local drag = ROLLING + AIR_DRAG * forward * forward
							forward -= sign * math.min(math.abs(forward), drag * dt)
							if handbrake then
								forward -= sign * math.min(math.abs(forward), BRAKE * 0.6 * dt)
							end
						end

						-- keys are all-or-nothing, so ease the input in instead of snapping
						steerInput += (steerIn - steerInput) * math.min(1, 5 * STEER_EASE * dt)
						-- turn rate: tight circle when slow, tyre grip when fast; zero when standing still
						local v = math.abs(forward)
						local maxYawRate = math.min(v / MIN_TURN_RADIUS, TURN_FAST + TURN_FALLOFF / math.max(v, 1)) * STEER_GAIN
						local yawRate = steerInput * maxYawRate * (forward >= 0 and 1 or -1)
						yaw -= yawRate * dt
						-- front wheel angle that matches this turn, for the visuals only
						steer = v > 1 and math.clamp(math.atan(yawRate * wheelbase / v), -0.6, 0.6) * (forward >= 0 and 1 or -1)
							or steerInput * 0.6
						if drifting then
							-- the rear steps out: steering swings the tail directly, so the slide stays controllable
							yaw -= steerIn * DRIFT_YAW * dt
						end

						-- velocity keeps its old direction; tyre grip removes the sideways part (less while drifting)
						lateral *= math.exp(-(drifting and DRIFT_GRIP or GRIP) * dt)
					else
						forward -= sign * math.min(math.abs(forward), AIR_DRAG * forward * forward * dt)
					end
					vel = heading * forward + lateral
					if drifting and vel.Magnitude > 1e-3 then
						-- sliding tyres swing the velocity toward the nose and only scrub a little speed
						local kept = math.max(speed - (DRIFT_SCRUB + ROLLING + AIR_DRAG * speed * speed) * dt, 0)
						vel = vel.Unit * math.max(vel.Magnitude, kept)
					end

					-- walls: three rays (centre and both sides) from the body edge, at kerb height so kerbs, stairs
					-- and ramp lips are driven over instead of counting as walls; only the push into the wall is lost
					local function blockWalls(v)
						local step = v * dt
						if step.Magnitude < 1e-3 then
							return v
						end
						local dir = step.Unit
						local ld = CFrame.Angles(0, yaw, 0):VectorToObjectSpace(dir)
						local zExt = ld.Z < 0 and -lo.Z or hi.Z
						local xExt = ld.X > 0 and hi.X or -lo.X
						local reach = math.min(
							math.abs(ld.X) > 1e-3 and xExt / math.abs(ld.X) or math.huge,
							math.abs(ld.Z) > 1e-3 and zExt / math.abs(ld.Z) or math.huge
						)
						local side = Vector3.new(-dir.Z, 0, dir.X) * ((hi.X - lo.X) * 0.4)
						local base = Vector3.new(pos.X, pos.Y - rideHeight + MAX_STEP + 0.3, pos.Z)
						for _, offset in ipairs({ Vector3.zero, side, -side }) do
							local wall = solidCast(base + offset, dir * (reach + step.Magnitude + 0.3))
							if wall and wall.Normal.Y < 0.5 then
								local n = Vector3.new(wall.Normal.X, 0, wall.Normal.Z).Unit
								local into = v:Dot(n)
								if into < 0 then
									v = (v - n * into) * 0.95
								end
							end
						end
						return v
					end
					vel = blockWalls(vel)
					local step = vel * dt

					-- every probe finds its own ground; together they give the chassis height, pitch and roll.
					-- Probes ride on the current tilt so on a hill they start above the slope, not inside it.
					local function probeGround(at)
						local tilt = CFrame.Angles(0, yaw, 0) * CFrame.Angles(chassisPitch, 0, chassisRoll)
						local probeCF = CFrame.new(at) * tilt
						local up = probeCF.UpVector
						local fSum, fN, fZ, rSum, rN, rZ = 0, 0, 0, 0, 0, 0
						local lSum, lN, lX, riSum, riN, riX = 0, 0, 0, 0, 0, 0
						local any = false
						for _, p in ipairs(probes) do
							local wp = probeCF * p.localPos
							p.hit = solidCast(wp + up * (MAX_STEP + p.radius), Vector3.new(0, -60, 0))
							local bottom = wp.Y - p.radius
							if not p.hit or p.hit.Position.Y < bottom - 1 then
								-- Already slightly under the surface (a seam, thin floor or fast drop): the first ray
								-- started inside/below it. Look again from higher, but only take a surface near the
								-- wheel so a bridge overhead can't grab the car.
								local high = solidCast(wp + Vector3.new(0, 8, 0), Vector3.new(0, -60, 0))
								if high and high.Position.Y <= bottom + MAX_STEP + 1 and high.Position.Y >= bottom - 3 then
									p.hit = high
								end
							end
							if p.hit then
								any = true
								local c = p.hit.Position.Y + p.radius -- where this wheel's centre wants to be
								if p.localPos.Z < 0 then
									fSum, fN, fZ = fSum + c, fN + 1, fZ + p.localPos.Z
								else
									rSum, rN, rZ = rSum + c, rN + 1, rZ + p.localPos.Z
								end
								if p.localPos.X > 0 then
									riSum, riN, riX = riSum + c, riN + 1, riX + p.localPos.X
								else
									lSum, lN, lX = lSum + c, lN + 1, lX + p.localPos.X
								end
							end
						end
						if not any then
							return nil
						end
						local pitch = (fN > 0 and rN > 0) and math.atan2(fSum / fN - rSum / rN, rZ / rN - fZ / fN) or chassisPitch
						local roll = (lN > 0 and riN > 0) and math.atan2(riSum / riN - lSum / lN, riX / riN - lX / lN) or chassisRoll
						pitch, roll = math.clamp(pitch, -0.6, 0.6), math.clamp(roll, -0.5, 0.5)
						-- driver-point height that puts the wheel centres on their targets at this tilt
						local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, roll)
						local sum, n = 0, 0
						for _, p in ipairs(probes) do
							if p.hit then
								sum, n = sum + p.hit.Position.Y + p.radius - (rot * p.localPos).Y, n + 1
							end
						end
						return sum / n, pitch, roll
					end

					local nextPos = pos + step
					local targetY, targetPitch, targetRoll = probeGround(nextPos)
					if targetY then
						lastGroundY, groundGrace = targetY, 0.12
					elseif groundGrace > 0 then
						-- every ray missed (crack between parts at speed): trust the last ground briefly instead of falling
						groundGrace -= dt
						targetY, targetPitch, targetRoll = lastGroundY, chassisPitch, chassisRoll
					end
					-- allow the normal rise of a slope this frame on top of the kerb height
					if targetY and targetY > pos.Y + MAX_STEP + step.Magnitude then
						-- a step this tall is a wall
						vel, step, nextPos = Vector3.zero, Vector3.zero, pos
						targetY, targetPitch, targetRoll = probeGround(pos)
					end

					-- Gravity always pulls. Grounded, vertical speed follows the slope you drive on, so hills hold the
					-- car down and ramps/crests launch it, while a kerb popped up in one frame doesn't.
					local predictedY = pos.Y + vy * dt -- where following the slope would put us
					vy -= workspace.Gravity * dt
					local y = pos.Y + vy * dt
					local wasGrounded = grounded
					grounded = false
					-- stay planted over small dips and downhill instead of hopping every frame
					local snap = (wasGrounded and vy <= 0) and 0.5 or 0
					if targetY and y <= targetY + snap then
						if not wasGrounded and vy < -25 then
							heaveV += vy * 0.02 -- landing thump
						end
						-- climb at most CLIMB_RATE so a bad hit can never fling the car upward
						local newY = math.min(targetY, math.max(y, pos.Y) + CLIMB_RATE * dt)
						-- only unexpected rises (bumps, kerbs) jolt the body; a steady slope doesn't
						heave = math.clamp(heave - (newY - predictedY) * 0.15, -0.25, 0.25)
						y = newY
						grounded = true
						local along = Vector3.new(step.X, 0, step.Z).Magnitude > 1e-3 and vel:Dot(CFrame.Angles(0, yaw, 0).LookVector) or 0
						vy = math.clamp(along * math.sin(targetPitch), -MAX_LAUNCH, MAX_LAUNCH)
						chassisPitch += (targetPitch - chassisPitch) * math.min(1, 15 * dt)
						chassisRoll += (targetRoll - chassisRoll) * math.min(1, 15 * dt)
					else
						-- in the air the car slowly levels out
						chassisPitch *= 1 - math.min(1, 1.5 * dt)
						chassisRoll *= 1 - math.min(1, 1.5 * dt)
					end
					pos = Vector3.new(nextPos.X, y, nextPos.Z)

					-- body on springs: squats under throttle, dives under braking, leans out of corners
					local longAccel = (forward - lastForward) / dt
					local latAccel = forward * (yaw - lastYaw) / dt
					lastForward = forward
					local function spring(x, v, target)
						v += (BODY_SPRING * (target - x) - BODY_DAMP * v) * dt
						return x + v * dt, v
					end
					bodyPitch, bodyPitchV = spring(bodyPitch, bodyPitchV, math.clamp(longAccel * BODY_PITCH, -0.04, 0.04))
					bodyRoll, bodyRollV = spring(bodyRoll, bodyRollV, math.clamp(-latAccel * BODY_ROLL, -0.05, 0.05))
					heave, heaveV = spring(heave, heaveV, 0)
					local body = CFrame.new(0, heave, 0) * CFrame.Angles(bodyPitch, 0, bodyRoll)

					local chassis = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(chassisPitch, 0, chassisRoll)
					carRoot.CFrame = chassis * body
					carRoot.AssemblyLinearVelocity = vel + Vector3.new(0, vy, 0)
					carRoot.AssemblyAngularVelocity = Vector3.zero

					-- wheels stay on the chassis (undoing the body motion), follow their own ground, steer and roll
					local unbody = body:Inverse()
					local slide = lateral.Magnitude
					for _, w in ipairs(wheels) do
						local want = 0
						if not grounded then
							want = -SUSPENSION_TRAVEL * 0.6
						elseif w.hit then
							local center = (chassis * w.localPos).Y
							want = math.clamp(w.hit.Position.Y + w.radius - center, -SUSPENSION_TRAVEL, SUSPENSION_TRAVEL)
						end
						w.susp += (want - w.susp) * math.min(1, 30 * dt)
						-- the handbrake locks the rear wheels
						if not (handbrake and not w.front) then
							w.spin = (w.spin - forward / w.radius * dt) % (2 * math.pi)
						end
						w.kWeld.C0 = unbody * CFrame.new(w.localPos + Vector3.new(0, w.susp, 0)) * CFrame.Angles(0, w.front and -steer or 0, 0)
						w.sWeld.C0 = CFrame.Angles(w.spin, 0, 0)
						if w.smoke then
							w.smoke.Enabled = drifting and val("FunCarSmoke", true)
							w.smoke.Rate = 30 + slide * 4
						end
					end
					-- tyres: the sideways slide, or a locked rear wheel dragging
					local scrub = grounded and math.max(slide, (handbrake and math.abs(forward) > 3) and math.abs(forward) or 0) or 0
					local soundOn = val("FunCarSounds", true)
					local revs = engineSound(dt, forward, throttle, grounded, drifting, scrub, soundOn)
					carFx(dt, revs, throttle, handbrake or (throttle < 0 and forward > 0.5), forward < -0.5, soundOn)

					if speedLabel then
						-- 1 stud = 0.28 m
						speedLabel:SetText(("Speed: <b>%d km/h</b>"):format(math.floor(vel.Magnitude * 0.28 * 3.6 + 0.5)))
					end
				end
				local reported = false
				car.conn = RunService.Heartbeat:Connect(function(dt)
					local ok, err = pcall(stepCar, dt)
					if not ok and not reported then
						-- report once so a broken frame shows up instead of a silently frozen car
						reported = true
						notify("Car error: " .. tostring(err))
					end
				end)

				-- weld the driver on top of the driver point (always this way, not the model's seat: other HuiG players
				-- place your car from your body alone, so the offset must be fixed)
				if car and car.root == carRoot then
					humanoid.Sit = true
					local weld = Instance.new("Weld")
					weld.Part0 = carRoot
					weld.Part1 = root
					weld.Parent = carRoot
					car.driverWeld, car.driverBase = weld, CFrame.new(0, SEAT_DROP, 0)
					welded = true
				end
				readSettings()
				applySeatHeight()
				if car and car.root == carRoot then
					HuiGSync.SetLocal(CAR_MARKERS[name] or "car", true)
				end
			end

			local GarageBox = Fun:AddRightTabbox("Vehicle Garage")
			local Garage = GarageBox:AddTab("Vehicle Garage", "car")
			local CarSettings = GarageBox:AddTab("Settings", "settings")

			Garage:AddDropdown("FunVehicleType", {
				Text = "Vehicle Type",
				Values = sortedKeys(VEHICLES),
				Default = 1,
				AllowNull = false,
				Multi = false,
				ValueImages = { Car = "car", Jet = "plane" },
				Callback = function(arg)
					if options.FunVehicle and VEHICLES[arg] then
						options.FunVehicle:SetValues(sortedKeys(VEHICLES[arg]))
						options.FunVehicle:SetValue(sortedKeys(VEHICLES[arg])[1])
					end
				end,
			})

