				if not model or not model:IsA("Model") then return end
				if model.Name ~= name then return end
				if skipNames[model.Name] then return end
				if Players:GetPlayerFromCharacter(model) then return end
				local root = model.PrimaryPart
					or model:FindFirstChild("Main")
					or model:FindFirstChild("SoundPart")
					or model:FindFirstChildWhichIsA("BasePart", true)
				if not root then return end
				local d = (root.Position - fromPos).Magnitude
				if d < bestDist then
					bestDist = d
					best = model
				end
			end

			local function walk(parent, depth)
				if not parent or depth > 12 then return end
				for _, ch in ipairs(parent:GetChildren()) do
					if ch:IsA("Model") then
						consider(ch)
						if depth < 8 then
							walk(ch, depth + 1)
						end
					elseif ch:IsA("Folder") or ch:IsA("Configuration") then
						walk(ch, depth + 1)
					end
				end
			end

			for _, plr in pairs(Players:GetPlayers()) do
				local folder = workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
				if folder then walk(folder, 0) end
			end
			local plotItems = workspace:FindFirstChild("PlotItems")
			if plotItems then walk(plotItems, 0) end
			local map = workspace:FindFirstChild("Map")
			if map then walk(map, 0) end
			walk(workspace, 0)

			return best, bestDist
		end

		local function stealUnspawnableToBuild(name, cf)
			local _, myRoot, myHum = tbl12.Char()
			if not myRoot or not myHum or myHum.Health <= 0 then
				return nil, "no character"
			end
			local target, dist = findNearestWorldToy(name, myRoot.Position)
			if not target then
				return nil, "not found in world: " .. tostring(name)
			end
			local soundPart = target:FindFirstChild("SoundPart")
			local main = target:FindFirstChild("Main")
			local nice = tbl12.FindNicePart(target) or soundPart or main or target.PrimaryPart
				or target:FindFirstChildWhichIsA("BasePart", true)
			if not nice then
				return nil, "no part: " .. tostring(name)
			end

			local returnCf = myRoot.CFrame
			tbl12.Teleport(myRoot, CFrame.new(nice.Position + Vector3.new(0, -4, 0)))
			task.wait(0.1)

			pcall(function()
				for _, p in ipairs(target:GetDescendants()) do
					if p:IsA("BasePart") and p.Anchored then
						p.Anchored = false
					end
				end
			end)

			pcall(function()
				if tbl12.Grab then
					tbl12.Grab(nice)
				end
			end)
			tbl12.SNO(nice)

			local t0 = tick()
			while tick() - t0 < 0.6 and target.Parent do
				if tbl12.IsPartOwner(nice) or tbl12.IsNetworkOwner(nice) then break end
				pcall(function() if tbl12.Grab then tbl12.Grab(nice) end end)
				tbl12.SNO(nice)
				task.wait()
			end
			if not target.Parent then
				tbl12.Teleport(myRoot, returnCf)
				return nil, "despawned while taking"
			end

			local ownPart = soundPart or nice
			local bp = nil
			local drive = main or ownPart
			if drive and drive.Parent then
				local old = drive:FindFirstChild("RSCBuildBP")
				if old then old:Destroy() end
				bp = Instance.new("BodyPosition")
				bp.Name = "RSCBuildBP"
				bp.D = 1500
				bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				bp.Position = cf.Position
				bp.Parent = drive
			end

			local now3 = tick()
			while target.Parent and tick() - now3 < 0.55 do
				if not tbl12.IsPartOwner(ownPart) then
					tbl12.SNO(ownPart)
				end
				if soundPart and soundPart.Parent then
					soundPart.CFrame = cf
					soundPart.AssemblyLinearVelocity = Vector3.new(0, -10, 0)
				elseif ownPart.Parent then
					ownPart.CFrame = cf
					ownPart.AssemblyLinearVelocity = Vector3.new(0, -10, 0)
				end
				if main and main.Parent and main ~= soundPart then
					main.CFrame = cf
				end
				if bp and bp.Parent then
					bp.Position = cf.Position
				end
				if target:IsA("Model") then
					pcall(tbl12.PivotTo, target, cf)
					pcall(function() target:PivotTo(cf) end)
				end
				task.wait()
			end
			if bp and bp.Parent then bp:Destroy() end
			pcall(function()
				if ownPart.Parent then
					ownPart.AssemblyLinearVelocity = Vector3.zero
					ownPart.CFrame = cf
				end
			end)

			pcall(tbl12.SetAnchored, target, true)
			local st = tbl7.Anchored and tbl7.Anchored[target]
			if st then st.CFrame = cf end

			pcall(function()
				if tbl12.RNO then tbl12.RNO(nice) end
			end)

			tbl12.Teleport(myRoot, returnCf)
			tbl12.ResetVelocity(myRoot)
			return target
		end

		local function loadBuild(name)
            if not (readfile and isfile and HttpService) then return false, "File read not supported" end
            if type(name) ~= "string" or name == "" then return false, "Select a build first" end
            if not isfile(buildPath(name)) then return false, "Build not found" end

            local folder = getSpawnFolder()
            if not spawnRemote or not folder then return false, "Spawn folder not ready" end

            local ok, content = pcall(readfile, buildPath(name))
            if not ok or type(content) ~= "string" then return false, "Read failed" end

            local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
            if not ok2 or type(data) ~= "table" or type(data.entries) ~= "table" then
                return false, "Invalid build file"
            end
            task.spawn(function()
                local loaded, failed = 0, 0
                local total = #data.entries

                local note
                pcall(function()
                    note = lib:Notify({
                        Title = "Anchor Load",
                        Description = ("0/%d…"):format(total),
                        Time = 999,
                        Persist = true,
                    })
                end)

                local function report()
                    if note then
                        pcall(function()
                            note:ChangeDescription(
                                ("%d/%d loaded (%d failed)"):format(loaded, total, failed)
                            )
                        end)
                    end
                end

                local function moveLikeRagdollPallet(toy, cf)
                    if not toy or not toy.Parent then return false end

                    local soundPart = toy:FindFirstChild("SoundPart") or toy:WaitForChild("SoundPart", 0.5)
                    local main = toy:FindFirstChild("Main") or toy:WaitForChild("Main", 0.5)
                    local ownPart = soundPart or main or toy.PrimaryPart or toy:FindFirstChildWhichIsA("BasePart")
                    if not ownPart then return false end

                    if not tbl12.IsPartOwner(ownPart) and not tbl12.SNO(ownPart) then
                        return false
                    end


                    local bp = nil
                    local drive = main or ownPart
                    if drive and drive.Parent then
                        local old = drive:FindFirstChild("RSCBuildBP")
                        if old then old:Destroy() end
                        bp = Instance.new("BodyPosition")
                        bp.Name = "RSCBuildBP"
                        bp.D = 1500
                        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bp.Position = cf.Position
                        bp.Parent = drive
                    end

                    local now3 = tick()
                    while toy.Parent and tick() - now3 < 0.25 do
                        if not tbl12.IsPartOwner(ownPart) then
                            tbl12.SNO(ownPart)
                        end
                        if soundPart and soundPart.Parent then
                            soundPart.CFrame = cf
                            soundPart.AssemblyLinearVelocity = Vector3.new(0, -10, 0)
                        end
                        if main and main.Parent and main ~= soundPart then
                            main.CFrame = cf
                        end
                        if bp and bp.Parent then
                            bp.Position = cf.Position
                        end
                        if toy:IsA("Model") then
                            pcall(tbl12.PivotTo, toy, cf)
                        end
                        task.wait()
                    end

                    if bp and bp.Parent then
                        bp:Destroy()
                    end
                    pcall(function()
                        if ownPart.Parent then
                            ownPart.AssemblyLinearVelocity = Vector3.zero
                            ownPart.AssemblyAngularVelocity = Vector3.zero
                            ownPart.CFrame = cf
                        end
                    end)
                    pcall(function()
                        for _, d in ipairs(toy:GetDescendants()) do
                            if d:IsA("BasePart") then
                                if d.Name ~= "SoundPart" and d.Name ~= "HoldPart" and d.Name ~= "FirePlayerPart" then
                                    d.CanCollide = true
                                end
                            end
                        end
                        if toy:IsA("BasePart") and toy.Name ~= "SoundPart" then
                            toy.CanCollide = true
                        end
                    end)
                    return true
                end

                for _, entry in ipairs(data.entries) do
                    if flag11 then break end

                    if type(entry) ~= "table" or type(entry.name) ~= "string" then
                        failed += 1; report(); continue
                    end
                    local cf = decodeCFrame(entry.cframe)
                    if not cf then
                        failed += 1; report(); continue
                    end

                    local toy = nil
                    if SPAWNABLE_TOYS[entry.name] then
                        toy = tbl12.SpawnToy(entry.name, nil, 8, true)
                    else
                        toy = "UNSPAWNABLE"
                    end

                    if toy == "UNSPAWNABLE" then
                        local stolen, err = stealUnspawnableToBuild(entry.name, cf)
                        if stolen then
                            loaded += 1
                        else
                            failed += 1
                            pcall(function()
                                fn18(("Unspawnable fail: %s (%s)"):format(tostring(entry.name), tostring(err or "?")), "Anchor Load")
                            end)
                        end
                        report()
                        continue
                    end

                    if not toy or not toy.Parent then
                        failed += 1; report(); continue
                    end

                    local moved = moveLikeRagdollPallet(toy, cf)

                    local anchored = false
                    pcall(function()
                        anchored = tbl12.SetAnchored(toy, true) == true
                    end)

                    local st = tbl7.Anchored and tbl7.Anchored[toy]
                    if st then
                        st.CFrame = cf
                    end

                    task.spawn(function()
                        if flag11 or not toy or not toy.Parent then return end
                        local soundPart = toy:FindFirstChild("SoundPart")
                        local main = toy:FindFirstChild("Main")
                        local ownPart = soundPart or main or toy.PrimaryPart
                        if not ownPart then return end
                        local t0 = tick()
                        while toy.Parent and not flag11 and tick() - t0 < 0.4 do
                            if not tbl12.IsPartOwner(ownPart) then
                                pcall(tbl12.SNO, ownPart)
                            end
                            if soundPart and soundPart.Parent then
                                soundPart.CFrame = cf
                            end
                            if main and main.Parent then
                                main.CFrame = cf
                            end
                            local st2 = tbl7.Anchored and tbl7.Anchored[toy]
                            if st2 then
                                st2.CFrame = cf
                            end
                            task.wait()
                        end
                    end)

                    if not moved or not anchored then
                        task.defer(function()
                            if flag11 or not toy or not toy.Parent then return end
                            task.wait(0.15)
                            if not toy.Parent then return end
                            moveLikeRagdollPallet(toy, cf)
                            pcall(tbl12.SetAnchored, toy, true)
                            local st3 = tbl7.Anchored and tbl7.Anchored[toy]
                            if st3 then st3.CFrame = cf end
                        end)
                    end

                    loaded += 1
                    report()
                end

                pcall(function()
                    for _, d in ipairs(workspace:GetDescendants()) do
                        if d.Name == "RSCBuildBP" then
                            d:Destroy()
                        end
                    end
                end)

                if note then pcall(function() note:Destroy() end) end
                fn18(
                    ("Loaded %d/%d (%d failed)"):format(loaded, total, failed),
                    "Anchor Load"
                )
            end)

            return true, #data.entries
        end

