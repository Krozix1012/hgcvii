CommandBarState.escapeChooserRichText = function(value)
	return tostring(value or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&apos;")
end

					CommandBarState.highlightChooserText = function(value, query, selected)
	local original = tostring(value or "")
	local safe = CommandBarState.escapeChooserRichText(original)
	query = tostring(query or ""):match("^%s*(.-)%s*$") or ""
	if query == "" then return safe end
	local first, last = original:lower():find(query:lower(), 1, true)
	if not first or not last then return safe end
	local before = CommandBarState.escapeChooserRichText(original:sub(1, first - 1))
	local matchText = CommandBarState.escapeChooserRichText(original:sub(first, last))
	local after = CommandBarState.escapeChooserRichText(original:sub(last + 1))
	local color = selected and "#ffffff" or "#f0c96a"
	return before .. '<font color="' .. color .. '"><b>' .. matchText .. '</b></font>' .. after
end

