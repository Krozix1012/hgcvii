		local function splitSettingAndValue(arguments)
			arguments = trim(arguments)
			local bestCandidate, bestValue, bestLength
			for _, candidate in ipairs(CommandBarState.Candidates) do
				if adjustableKinds[candidate.Kind] then
					for _, prefix in ipairs({ candidate.Id, candidate.Name }) do
						local lowerArgs, lowerPrefix = arguments:lower(), prefix:lower()
						if #prefix > 0 and #arguments > #prefix and lowerArgs:sub(1, #prefix + 1) == lowerPrefix .. " " then
							if not bestLength or #prefix > bestLength then
								bestCandidate = candidate
								bestValue = trim(arguments:sub(#prefix + 1))
								bestLength = #prefix
							end
						end
					end
				end
			end
			return bestCandidate, bestValue
		end

