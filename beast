                            ForestFadeLevel = math.max(ForestFadeLevel - (1 / 3) * deltaTime, target)
                        end
                        for soundKey, sound in pairs(ForestAmbientSounds) do
                            local volume = 0
                            if ForestSoundSelected[soundKey] then
                                volume = ForestFadeLevel * (ForestSoundVolume[soundKey] or 0)
                            end
                            sound.Volume = volume
                            if volume > 0.001 and not sound.IsPlaying then
                                sound:Play()
                            elseif volume <= 0.001 and sound.IsPlaying then
                                sound:Pause()
                            end
                        end
                        if math.abs(ForestFadeLevel - target) < 0.001 then
                            forestStopFade()
                        end
                    end)
