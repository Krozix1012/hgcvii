		local function findTeleportLocation(query)
			if typeof(query) == "Instance" then return query end
			local wanted = normalizeLookup(query)
			if wanted == "" then return nil end
			local alias = { hauntedhouse = "spookyhouse", spookyhouse = "spookyhouse", spawnlocation = "spawn" }
			wanted = alias[wanted] or wanted
			local exact, partial = nil, {}
			for _, location in ipairs(getTeleportLocations()) do
				local name = normalizeLookup(location.Name)
				name = alias[name] or name
				if name == wanted then exact = location; break end
				if name:sub(1, #wanted) == wanted then table.insert(partial, location) end
			end
			if exact then return exact end
			if #partial == 1 then return partial[1] end
			if #partial > 1 then return nil, "Location name is ambiguous; type more characters." end
			return nil, "Player or teleport location not found: " .. tostring(query)
		end

		local function teleportToQuery(query)
