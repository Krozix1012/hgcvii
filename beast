						CommandBarState.CommandFilter = nil
						table.clear(CommandBarState.VisibleCandidates)
						CommandBarState.clearPlayerChooserRows()
						if playerChooserFrame then playerChooserFrame.Visible = false; playerChooserFrame.Size = UDim2.fromOffset(568,0); playerChooserFrame.BackgroundTransparency = 1 end
						if playerChooserStroke then playerChooserStroke.Transparency = 1 end
